package public

templ Error(errorMessage string) {
	<!doctype html>
	<html lang="en" class="h-full bg-slate-50">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Security Alert - Sprezz Identity</title>
		<script src="https://unpkg.com/htmx.org@1.9.12" nonce={ templ.GetNonce(ctx) }></script>
		<script src="https://cdn.tailwindcss.com" nonce={ templ.GetNonce(ctx) }></script>
	</head>
	<body class="h-full flex items-center justify-center p-6">
		<div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden text-center">
			<!-- Alert Header -->
			<div class="px-8 pt-8 pb-6 bg-red-600 text-white flex flex-col items-center">
				<svg class="h-16 w-16 mb-2 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
				</svg>
				<h1 class="text-2xl font-bold tracking-wider">SECURITY ALERT</h1>
			</div>

			<!-- Alert Body -->
			<div class="p-8 space-y-6">
				<div class="p-4 bg-red-50 border border-red-100 rounded-xl text-red-900 text-sm font-medium">
					<p class="font-bold text-base mb-1 text-red-800">Request Blocked</p>
					<p class="break-words">{ errorMessage }</p>
				</div>

				<p class="text-xs text-slate-500">
					Please contact your administrator if you believe this is an error.
				</p>
			</div>
		</div>
	</body>
	</html>
}
