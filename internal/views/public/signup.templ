package public

import (
	"sprezz-identity/internal/domain/model"
	"sprezz-identity/internal/domain/port"
)

// SignUp handles the full, un-nested initial page landing shell (Served on GET requests)
templ SignUp(fieldErrors map[string]string, provider *model.IdentityProvider, email string, username string, name string, interactionID string) {
	<!doctype html>
	<html lang="en" class="h-full bg-slate-50">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Sign Up - Sprezz Identity</title>
		<script src="https://unpkg.com/htmx.org@1.9.12" nonce={ templ.GetNonce(ctx) }></script>
		<script src="https://cdn.tailwindcss.com" nonce={ templ.GetNonce(ctx) }></script>
	</head>
	<body class="h-full flex items-center justify-center p-6">
		<div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden">
			<!-- Header -->
			<div class="px-8 pt-8 pb-6 bg-slate-900 text-center text-white">
				<h1 class="text-2xl font-bold tracking-wider">CREATE ACCOUNT</h1>
				<p class="text-sm text-slate-400 mt-2">Get started with your new profile</p>
			</div>

			<!-- Body Container -->
			<div class="p-8">
				@SignUpForm(fieldErrors, provider, email, username, name, interactionID)
			</div>
		</div>
	</body>
	</html>
}

// SignUpForm handles the lean hypermedia form block (Swapped dynamically on POST validation errors)
templ SignUpForm(fieldErrors map[string]string, provider *model.IdentityProvider, email string, username string, name string, interactionID string) {
	<div id="signup-result" class="mb-6">
		if fieldErrors["global"] != "" {
			<div class="p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm font-medium">
				{ fieldErrors["global"] }
			</div>
		}
	</div>

	<form hx-post={ port.RouteWebSignUp } hx-target="this" hx-swap="outerHTML" class="space-y-4">
		<input type="hidden" name="tx" value={ interactionID } />

		<div>
			<label class="block text-sm font-medium text-slate-700 mb-1">Display Name</label>
			if fieldErrors["name"] != "" {
				<input
					type="text"
					name="name"
					value={ name }
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
					placeholder="Your full name"
				/>
				<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["name"] }</p>
			} else {
				<input
					type="text"
					name="name"
					value={ name }
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-slate-300 focus:ring-blue-500 focus:border-blue-500"
					placeholder="Your full name"
				/>
			}
		</div>

		if provider.Config.UsernameField == "email" {
			<div>
				<label class="block text-sm font-medium text-slate-700 mb-1">Email Address</label>
				if fieldErrors["email"] != "" {
					<input
						type="email"
						name="email"
						value={ email }
						required
						class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
						placeholder="you@domain.com"
					/>
					<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["email"] }</p>
				} else {
					<input
						type="email"
						name="email"
						value={ email }
						required
						class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-slate-300 focus:ring-blue-500 focus:border-blue-500"
						placeholder="you@domain.com"
					/>
				}
			</div>
		} else {
			<div>
				<label class="block text-sm font-medium text-slate-700 mb-1">Username</label>
				if fieldErrors["username"] != "" {
					<input
						type="text"
						name="username"
						value={ username }
						required
						class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
						placeholder="Choose a username"
					/>
					<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["username"] }</p>
				} else {
					<input
						type="text"
						name="username"
						value={ username }
						required
						class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-slate-300 focus:ring-blue-500 focus:border-blue-500"
						placeholder="Choose a username"
					/>
				}
			</div>

			<div>
				<label class="block text-sm font-medium text-slate-700 mb-1">Email Address</label>
				if fieldErrors["email"] != "" {
					<input
						type="email"
						name="email"
						value={ email }
						required
						class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
						placeholder="you@domain.com"
					/>
					<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["email"] }</p>
				} else {
					<input
						type="email"
						name="email"
						value={ email }
						required
						class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-slate-300 focus:ring-blue-500 focus:border-blue-500"
						placeholder="you@domain.com"
					/>
				}
			</div>
		}

		<div>
			<label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
			if fieldErrors["password"] != "" {
				<input
					type="password"
					name="password"
					minlength="8"
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
					placeholder="Minimum 8 characters"
				/>
				<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["password"] }</p>
			} else {
				<input
					type="password"
					name="password"
					minlength="8"
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-slate-300 focus:ring-blue-500 focus:border-blue-500"
					placeholder="Minimum 8 characters"
				/>
			}
		</div>

		<div>
			<label class="block text-sm font-medium text-slate-700 mb-1">Confirm Password</label>
			if fieldErrors["confirm_password"] != "" {
				<input
					type="password"
					name="confirm_password"
					minlength="8"
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
					placeholder="Re-enter password"
				/>
				<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["confirm_password"] }</p>
			} else {
				<input
					type="password"
					name="confirm_password"
					minlength="8"
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-slate-300 focus:ring-blue-500 focus:border-blue-500"
					placeholder="Re-enter password"
				/>
			}
		</div>

		<div class="pt-2 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
			<button
				type="submit"
				class="w-full sm:w-auto px-5 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm"
			>
				Sign Up
			</button>

			<div class="text-center sm:text-right text-sm text-slate-500">
				<span class="mr-1">already have an account?</span>
				<a href={ port.RouteRoot } class="text-blue-600 hover:text-blue-700 font-semibold underline transition">
					Sign in
				</a>
			</div>
		</div>
	</form>
}
