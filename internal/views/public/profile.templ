package public

import (
	"fmt"

	"sprezz-identity/internal/domain/model"
	"sprezz-identity/internal/domain/port"
)

// ProfileDashboard serves the full outer page shell context (GET requests only)
templ ProfileDashboard(user model.UserProfile, identities []model.UserIdentity, providers []model.IdentityProvider, hasPasswordIdp bool, errorMsg, successMsg string) {
	<!doctype html>
	<html lang="en" class="h-full bg-slate-50">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>My Profile - Sprezz Identity</title>
		<script src="https://unpkg.com/htmx.org@1.9.12" nonce={ templ.GetNonce(ctx) }></script>
		<script src="https://cdn.tailwindcss.com" nonce={ templ.GetNonce(ctx) }></script>
	</head>
	<body class="h-full flex flex-col items-center justify-start p-6 bg-slate-50">
		<div class="w-full max-w-2xl bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden my-8">
			<!-- Header -->
			<div class="px-8 py-6 bg-slate-900 text-white flex justify-between items-center">
				<div>
					<h1 class="text-2xl font-bold tracking-wider">MY PROFILE</h1>
					<p class="text-sm text-slate-400 mt-1">Manage your account details and connected identities</p>
				</div>
				<a href={ port.RouteWebLogout } class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-sm font-semibold transition">
					Sign Out
				</a>
			</div>

			<!-- Alerts -->
			<div class="px-8 pt-6">
				if errorMsg != "" {
					<div class="p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm font-medium">
						{ errorMsg }
					</div>
				}
				if successMsg != "" {
					<div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
						{ successMsg }
					</div>
				}
			</div>

			<div class="p-8 space-y-8">
				<div id="user-details-pane" class="space-y-4">
					@UserDetails(user, hasPasswordIdp)
				</div>

				<!-- Section 2: Identities -->
				<div class="space-y-4">
					<h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-2">Coupled Identities</h2>
					if len(identities) == 0 {
						<p class="text-sm text-slate-500">No identities connected to this profile yet.</p>
					} else {
						<div class="grid grid-cols-1 gap-4" id="coupled-identities">
							for _, ident := range identities {
								<div class="flex items-center justify-between p-4 border border-slate-100 bg-slate-50 rounded-xl">
									<div class="space-y-1">
										<p class="font-bold text-slate-800 text-sm">
											for _, p := range providers {
												if p.ID == ident.IdentityProviderID {
													if p.Name != "" {
														{ p.Name } <span class="text-xs text-slate-400 capitalize">({ string(p.IDPType) })</span>
													} else {
														{ p.Alias } <span class="text-xs text-slate-400 capitalize">({ string(p.IDPType) })</span>
													}
												}
											}
										</p>
										<div class="text-2xs text-slate-400 flex flex-wrap gap-x-3">
											<span>Login Count: { fmt.Sprintf("%d", ident.LoginCount) }</span>
											<span>|</span>
											<span>Status: Active</span>
										</div>
										<p class="text-2xs text-slate-400">Coupled at: { ident.CoupledAt.Format("2006-01-02 15:04:05") }</p>
									</div>
									for _, p := range providers {
										if p.ID == ident.IdentityProviderID && (p.IDPType != model.UsernamePasswordIDPType || p.Config.AllowDecoupling) {
											<button
												hx-delete={ fmt.Sprintf("%s%s/%s", port.RouteWebProfile, port.RouteWebProfileIdentities, ident.IdentityProviderID.String()) }
												hx-confirm="Are you sure you want to decouple this identity from your profile?"
												hx-target="body"
												class="px-3 py-1.5 bg-red-50 text-red-600 hover:bg-red-100 rounded-lg text-xs font-semibold transition"
											>
												Decouple
											</button>
										}
									}
								</div>
							}
						</div>
					}
				</div>
			</div>
		</div>
	</body>
	</html>
}

// UserDetails represents the clean isolated grid panel data layer
templ UserDetails(user model.UserProfile, hasPasswordIdp bool) {
	<h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-2">User Details</h2>
	<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
		<div class="p-4 bg-slate-50 border border-slate-100 rounded-xl space-y-1">
			<span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Full Name</span>
			<p class="text-sm font-medium text-slate-800">{ user.Name }</p>
		</div>
		<div class="p-4 bg-slate-50 border border-slate-100 rounded-xl space-y-1">
			<span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Preferred Username</span>
			<p class="text-sm font-mono text-slate-800">{ user.PreferredUsername }</p>
		</div>
		<div class="p-4 bg-slate-50 border border-slate-100 rounded-xl space-y-1 col-span-1 md:col-span-2 flex items-center justify-between">
			<div>
				<span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block">Email Address</span>
				<p class="text-sm font-medium text-slate-800 inline-flex items-center gap-2">
					{ user.Email }
					if user.EmailVerified {
						<span class="inline-flex items-center px-2 py-0.5 rounded-full text-2xs font-medium bg-green-100 text-green-800 border border-green-200">Verified</span>
					} else {
						<span class="inline-flex items-center px-2 py-0.5 rounded-full text-2xs font-medium bg-amber-100 text-amber-800 border border-amber-200">Unverified</span>
					}
				</p>
			</div>
		</div>
	</div>

	if hasPasswordIdp {
		<div class="pt-4 flex flex-wrap gap-3">
			<a href={ port.RouteWebProfile + port.RouteWebProfileName } class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-sm transition">
				Change Name
			</a>
			<a href={ port.RouteWebProfile + port.RouteWebProfileEmail } class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-sm transition">
				Change Email
			</a>
			<a href={ port.RouteWebProfile + port.RouteWebProfilePassword } class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-sm transition">
				Change Password
			</a>
		</div>
	}
}

// ChangePasswordPage handles the full layout framework context for password credential mutation requests.
templ ChangePasswordPage(fieldErrors map[string]string, successMsg string) {
	<!doctype html>
	<html lang="en" class="h-full bg-slate-50">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Change Password - Sprezz Identity</title>
		<script src="https://unpkg.com/htmx.org@1.9.12" nonce={ templ.GetNonce(ctx) }></script>
		<script src="https://cdn.tailwindcss.com" nonce={ templ.GetNonce(ctx) }></script>
	</head>
	<body class="h-full flex items-center justify-center p-6 bg-slate-50">
		<div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden">
			<!-- Header -->
			<div class="px-8 pt-8 pb-6 bg-slate-900 text-center text-white">
				<h1 class="text-2xl font-bold tracking-wider">CHANGE PASSWORD</h1>
				<p class="text-sm text-slate-400 mt-2">Update your secure password credentials</p>
			</div>

			<!-- Body Container -->
			<div class="p-8">
				@ChangePasswordForm(fieldErrors, successMsg)
			</div>
		</div>
	</body>
	</html>
}

// ChangePasswordForm represents the hot-swappable inner markup sub-component.
// Refactored to fully support browser-native password generators and credential managers.
templ ChangePasswordForm(fieldErrors map[string]string, successMsg string) {
	<div id="password-result" class="mb-6">
		if fieldErrors["global"] != "" {
			<div class="p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm font-medium">
				{ fieldErrors["global"] }
			</div>
		}
		if successMsg != "" {
			<div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
				{ successMsg }
			</div>
		}
	</div>

	<form hx-post={ port.RouteWebProfile + port.RouteWebProfilePassword } hx-target="body" hx-swap="innerHTML" class="space-y-4">

		// 1. CURRENT PASSWORD: Must appear first with autocomplete="current-password"
		<div>
			<label for="current_password" class="block text-sm font-medium text-slate-700 mb-1">Provide Current Password</label>
			if fieldErrors["current_password"] != "" {
				<input
					type="password"
					id="current_password"
					name="current_password"
					autocomplete="current-password"
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
					placeholder="Enter current password"
				/>
				<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["current_password"] }</p>
			} else {
				<input
					type="password"
					id="current_password"
					name="current_password"
					autocomplete="current-password"
					required
					class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm"
					placeholder="Enter current password"
				/>
			}
		</div>

		// 2. NEW PASSWORD: Built-in trigger for password manager generator via autocomplete="new-password"
		<div>
			<label for="new_password" class="block text-sm font-medium text-slate-700 mb-1">New Password</label>
			if fieldErrors["new_password"] != "" {
				<input
					type="password"
					id="new_password"
					name="new_password"
					autocomplete="new-password"
					minlength="8"
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
					placeholder="Minimum 8 characters"
				/>
				<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["new_password"] }</p>
			} else {
				<input
					type="password"
					id="new_password"
					name="new_password"
					autocomplete="new-password"
					minlength="8"
					required
					class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm"
					placeholder="Minimum 8 characters"
				/>
			}
		</div>

		// 3. CONFIRM PASSWORD: Linked pair targets generation filling via autocomplete="new-password"
		<div>
			<label for="confirm_password" class="block text-sm font-medium text-slate-700 mb-1">Confirm New Password</label>
			if fieldErrors["confirm_password"] != "" {
				<input
					type="password"
					id="confirm_password"
					name="confirm_password"
					autocomplete="new-password"
					minlength="8"
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
					placeholder="Confirm new password"
				/>
				<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["confirm_password"] }</p>
			} else {
				<input
					type="password"
					id="confirm_password"
					name="confirm_password"
					autocomplete="new-password"
					minlength="8"
					required
					class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm"
					placeholder="Confirm new password"
				/>
			}
		</div>

		<div class="pt-2 flex gap-3">
			<button
				type="submit"
				class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold transition shadow-sm"
			>
				Save Password
			</button>
			<a
				href={ port.RouteWebProfile }
				class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-semibold transition text-center"
			>
				Cancel
			</a>
		</div>
	</form>
}

// ChangeEmailPage handles the initial page layout context for email address transformation requests.
templ ChangeEmailPage(currentEmail string, fieldErrors map[string]string, successMsg string) {
	<!doctype html>
	<html lang="en" class="h-full bg-slate-50">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Change Email - Sprezz Identity</title>
		<script src="https://unpkg.com/htmx.org@1.9.12" nonce={ templ.GetNonce(ctx) }></script>
		<script src="https://cdn.tailwindcss.com" nonce={ templ.GetNonce(ctx) }></script>
	</head>
	<body class="h-full flex items-center justify-center p-6 bg-slate-50">
		<div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden">
			<div class="px-8 pt-8 pb-6 bg-slate-900 text-center text-white">
				<h1 class="text-2xl font-bold tracking-wider">CHANGE EMAIL</h1>
				<p class="text-sm text-slate-400 mt-2">Update your email address</p>
			</div>

			<div class="p-8">
				@ChangeEmailForm(currentEmail, "", "", fieldErrors, successMsg)
			</div>
		</div>
	</body>
	</html>
}

// ChangeEmailForm represents the lean isolated element block for out-of-bounds partial swaps.
// Re-ordered into a tight authentication block first to keep password managers from auto-filling new email fields.
templ ChangeEmailForm(currentEmail, typedNewEmail, typedConfirmEmail string, fieldErrors map[string]string, successMsg string) {
	<div id="email-result" class="mb-6">
		if fieldErrors["global"] != "" {
			<div class="p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm font-medium">
				{ fieldErrors["global"] }
			</div>
		}
		if successMsg != "" {
			<div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
				{ successMsg }
			</div>
		}
	</div>

	<form hx-post={ port.RouteWebProfile + port.RouteWebProfileEmail } hx-target="body" hx-swap="innerHTML" class="space-y-4">

		// 1. ANCHOR IDENTITY: Placed at the top to initialize extension matching
		<div>
			<label for="current_email" class="block text-sm font-medium text-slate-700 mb-1">Current Email Address</label>
			<input
				type="email"
				id="current_email"
				name="current_email"
				value={ currentEmail }
				readonly
				autocomplete="username email"
				class="w-full px-3 py-2 border border-slate-300 rounded-lg bg-slate-50 text-slate-500 shadow-sm focus:outline-none transition text-sm cursor-not-allowed"
			/>
		</div>

		// 2. AUTHENTICATION GATE: Paired directly below identity anchor for tight credentials matching
		<div>
			<label for="current_password" class="block text-sm font-medium text-slate-700 mb-1">Provide Current Password</label>
			if fieldErrors["current_password"] != "" {
				<input
					type="password"
					id="current_password"
					name="current_password"
					autocomplete="current-password"
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
					placeholder="Enter current password"
				/>
				<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["current_password"] }</p>
			} else {
				<input
					type="password"
					id="current_password"
					name="current_password"
					autocomplete="current-password"
					required
					class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm"
					placeholder="Enter current password"
				/>
			}
		</div>

		// 3. TARGET MUTATION: Isolated down-funnel to prevent autofill corruption
		<div>
			<label for="new_email" class="block text-sm font-medium text-slate-700 mb-1">New Email Address</label>
			if fieldErrors["new_email"] != "" {
				<input
					type="email"
					id="new_email"
					name="new_email"
					value={ typedNewEmail }
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
					placeholder="new@domain.com"
				/>
				<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["new_email"] }</p>
			} else {
				<input
					type="email"
					id="new_email"
					name="new_email"
					value={ typedNewEmail }
					required
					class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm"
					placeholder="new@domain.com"
				/>
			}
		</div>

		// 4. CHANGE MIRROR: Confirms structural email entry consistency
		<div>
			<label for="confirm_email" class="block text-sm font-medium text-slate-700 mb-1">Confirm New Email Address</label>
			if fieldErrors["confirm_email"] != "" {
				<input
					type="email"
					id="confirm_email"
					name="confirm_email"
					value={ typedConfirmEmail }
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
					placeholder="Confirm new email"
				/>
				<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["confirm_email"] }</p>
			} else {
				<input
					type="email"
					id="confirm_email"
					name="confirm_email"
					value={ typedConfirmEmail }
					required
					class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm"
					placeholder="Confirm new email"
				/>
			}
		</div>

		<div class="pt-2 flex gap-3">
			<button
				type="submit"
				class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold transition shadow-sm"
			>
				Save Email
			</button>
			<a
				href={ port.RouteWebProfile }
				class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-semibold transition text-center"
			>
				Cancel
			</a>
		</div>
	</form>
}

// ChangeNamePage handles the initial page layout context for name attribute updates.
templ ChangeNamePage(currentName string, fieldErrors map[string]string, successMsg string) {
	<!doctype html>
	<html lang="en" class="h-full bg-slate-50">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Change Name - Sprezz Identity</title>
		<script src="https://unpkg.com/htmx.org@1.9.12" nonce={ templ.GetNonce(ctx) }></script>
		<script src="https://cdn.tailwindcss.com" nonce={ templ.GetNonce(ctx) }></script>
	</head>
	<body class="h-full flex items-center justify-center p-6 bg-slate-50">
		<div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden">
			<div class="px-8 pt-8 pb-6 bg-slate-900 text-center text-white">
				<h1 class="text-2xl font-bold tracking-wider">CHANGE NAME</h1>
				<p class="text-sm text-slate-400 mt-2">Update your display name</p>
			</div>

			<div class="p-8">
				@ChangeNameForm(currentName, "", fieldErrors, successMsg)
			</div>
		</div>
	</body>
	</html>
}

// ChangeNameForm represents the lean isolated block layout swap targeting name attributes.
// Re-ordered to present the uneditable current reference name at the top as the visual anchor.
templ ChangeNameForm(currentName, typedNewName string, fieldErrors map[string]string, successMsg string) {
	<div id="name-result" class="mb-6">
		if fieldErrors["global"] != "" {
			<div class="p-4 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm font-medium">
				{ fieldErrors["global"] }
			</div>
		}
		if successMsg != "" {
			<div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
				{ successMsg }
			</div>
		}
	</div>

	<form hx-post={ port.RouteWebProfile + port.RouteWebProfileName } hx-target="body" hx-swap="innerHTML" class="space-y-4">

		// 1. CURRENT VALUE ANCHOR: Placed first as a read-only visual reference row
		<div>
			<label for="current_name" class="block text-sm font-medium text-slate-700 mb-1">Current Full Name</label>
			<input
				type="text"
				id="current_name"
				name="current_name"
				value={ currentName }
				readonly
				class="w-full px-3 py-2 border border-slate-300 rounded-lg bg-slate-50 text-slate-500 shadow-sm focus:outline-none transition text-sm cursor-not-allowed"
			/>
		</div>

		// 2. TARGET MUTATION FIELD: Placed below the reference row to ingest the new string value
		<div>
			<label for="new_name" class="block text-sm font-medium text-slate-700 mb-1">New Full Name</label>
			if fieldErrors["new_name"] != "" {
				<input
					type="text"
					id="new_name"
					name="new_name"
					value={ typedNewName }
					required
					class="w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm border-red-300 bg-red-50 focus:ring-red-500 focus:border-red-500"
					placeholder="Enter new full name"
				/>
				<p class="mt-1 text-xs font-medium text-red-600">{ fieldErrors["new_name"] }</p>
			} else {
				<input
					type="text"
					id="new_name"
					name="new_name"
					value={ typedNewName }
					required
					class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 transition text-sm focus:ring-blue-500 focus:border-blue-500"
					placeholder="Enter new full name"
				/>
			}
		</div>

		<div class="pt-2 flex gap-3">
			<button
				type="submit"
				class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold transition shadow-sm"
			>
				Save Name
			</button>
			<a
				href={ port.RouteWebProfile }
				class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-semibold transition text-center"
			>
				Cancel
			</a>
		</div>
	</form>
}
