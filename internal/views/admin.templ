package views

import (
	"fmt"
	"sprezz-identity/internal/domain/model"
)

templ AdminLayout(title string) {
	<!doctype html>
	<html lang="en" class="h-full bg-slate-50">
	<head>
		<meta charset="utf-8" />
		<title>{ title } | Sprezz Identity Admin</title>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<script src="https://unpkg.com/htmx.org@1.9.12" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" nonce={ templ.GetNonce(ctx) }></script>
		<script src="https://cdn.tailwindcss.com" nonce={ templ.GetNonce(ctx) }></script>
	</head>
	<body class="h-full flex overflow-hidden">
		<!-- Sidebar -->
		<aside class="w-64 bg-slate-900 text-slate-300 flex-shrink-0 flex flex-col hidden md:flex">
			<div class="h-16 flex items-center px-6 border-b border-slate-800">
				<span class="text-xl font-bold text-white tracking-wider">SPREZZ IDENTITY</span>
			</div>
			<nav class="flex-1 p-4 space-y-2 overflow-y-auto">
				<a href="/admin/dashboard" class="flex items-center px-4 py-3 bg-slate-800 text-white rounded-lg font-medium transition duration-150">
					Dashboard
				</a>
			</nav>
			<div class="p-4 border-t border-slate-800">
				<div class="flex items-center space-x-3">
					<div class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center text-white font-bold">
						A
					</div>
					<div>
						<p class="text-sm font-semibold text-white">Global Admin</p>
						<a href="/logout" class="text-xs text-slate-400 hover:text-white underline">Sign out</a>
					</div>
				</div>
			</div>
		</aside>

		<!-- Main Content Area -->
		<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
			<!-- Header -->
			<header class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 z-10">
				<h1 class="text-xl font-bold text-slate-800">{ title }</h1>
				<div class="flex items-center space-x-4">
					<span class="text-sm text-slate-500">v1.0.0</span>
				</div>
			</header>

			<!-- Content Wrapper -->
			<main class="flex-1 overflow-y-auto p-6">
				{ children... }
			</main>
		</div>

		<!-- Global Modal Container -->
		<div id="modal-container"></div>
	</body>
	</html>
}

templ InputField(label, name, typeValue, value, errorStr string) {
	<div class="mb-4">
		<label class="block text-sm font-medium text-slate-700 mb-1">{ label }</label>
		<input
			type={ typeValue }
			name={ name }
			value={ value }
			class={ "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", templ.KV("border-red-500 focus:ring-red-500 focus:border-red-500", errorStr != ""), templ.KV("border-slate-300", errorStr == "") }
		/>
		if errorStr != "" {
			<p class="text-xs text-red-500 mt-1">{ errorStr }</p>
		}
	</div>
}

templ StatusBadge(isActive bool) {
	if isActive {
		<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
			Active
		</span>
	} else {
		<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 border border-red-200">
			Locked
		</span>
	}
}

templ Modal(title, fetchUrl string) {
	<div
		x-data="{ isOpen: true }"
		x-show="isOpen"
		class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm"
		@keydown.escape.window="isOpen = false; document.getElementById('modal-container').innerHTML = ''"
	>
		<div
			class="bg-white rounded-xl shadow-xl w-full max-w-lg overflow-hidden flex flex-col transform transition-all"
			@click.outside="isOpen = false; document.getElementById('modal-container').innerHTML = ''"
		>
			<div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
				<h3 class="text-lg font-bold text-slate-800">{ title }</h3>
				<button
					type="button"
					class="text-slate-400 hover:text-slate-600 transition"
					@click="isOpen = false; document.getElementById('modal-container').innerHTML = ''"
				>
					✕
				</button>
			</div>
			<div id="modal-body" class="p-6 overflow-y-auto max-h-[70vh]" hx-get={ fetchUrl } hx-trigger="load">
				<div class="flex justify-center py-8">
					<svg class="animate-spin h-8 w-8 text-blue-500" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
					</svg>
				</div>
			</div>
		</div>
	</div>
}

templ AdminDashboard(tenantID string, allowSignup bool, tenants []model.Tenant, msg string) {
	@AdminLayout("Dashboard") {
		<div class="space-y-6">
			if msg != "" {
				<div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
					{ msg }
				</div>
			}

			<!-- Lockdown Panel -->
			<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
				<div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
					<h2 class="font-bold text-slate-800">Administrative Lockdown Panel</h2>
					@StatusBadge(allowSignup)
				</div>
				<div class="p-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
					<div>
						<p class="text-sm font-semibold text-slate-800">Public Registration State</p>
						<p class="text-sm text-slate-500 mt-1">
							When public registration is Active, new administrative user profiles can self-register. Turn this Off to secure your admin partition permanently.
						</p>
					</div>
					<div>
						<button
							hx-patch={ fmt.Sprintf("/admin/tenants/%s/toggle-signup", tenantID) }
							hx-swap="outerHTML"
							class={ "px-4 py-2 rounded-lg font-semibold text-sm transition shadow-sm", templ.KV("bg-red-600 text-white hover:bg-red-700", allowSignup), templ.KV("bg-green-600 text-white hover:bg-green-700", !allowSignup) }
						>
							if allowSignup {
								Turn Off Registration
							} else {
								Turn On Registration
							}
						</button>
					</div>
				</div>
			</div>

			<!-- Tenant Management -->
			<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
				<div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
					<h2 class="font-bold text-slate-800">Tenant Management</h2>
					<button
						hx-get="/admin/tenants/new"
						hx-target="#modal-container"
						class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm"
					>
						+ Create Tenant
					</button>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full text-left border-collapse text-sm">
						<thead>
							<tr class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-200">
								<th class="px-6 py-3">Tenant Name</th>
								<th class="px-6 py-3">Canonical Domain</th>
								<th class="px-6 py-3">Status</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-200">
							for _, t := range tenants {
								<tr class="hover:bg-slate-50 transition">
									<td class="px-6 py-4 font-medium text-slate-900">{ t.Name }</td>
									<td class="px-6 py-4 text-slate-500">{ t.Domain }</td>
									<td class="px-6 py-4">
										@StatusBadge(t.IsActive)
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

templ CreateTenantForm(errors map[string]string) {
	<form hx-post="/admin/tenants" hx-target="#modal-body" class="space-y-4">
		@InputField("Tenant Name", "name", "text", "", errors["name"])
		@InputField("Canonical Domain", "domain", "text", "", errors["domain"])
		<div class="flex justify-end space-x-3 pt-4 border-t border-slate-200">
			<button
				type="button"
				class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition"
				@click="isOpen = false; document.getElementById('modal-container').innerHTML = ''"
			>
				Cancel
			</button>
			<button
				type="submit"
				class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition"
			>
				Create Tenant
			</button>
		</div>
	</form>
}
