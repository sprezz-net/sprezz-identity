package views

import (
    "fmt"
    "strings"
    "sprezz-identity/internal/domain/model"
)

type AdminLayoutProps struct {
    Title       string
    CurrentTab  string
    TenantName  string
}

templ AdminLayout(props AdminLayoutProps) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>{ props.Title } | Sprezz Identity Admin</title>
        <!-- Tailwind CSS -->
        <script src="https://cdn.tailwindcss.com" nonce={ templ.GetNonce(ctx) }></script>
        <!-- HTMX -->
        <script src="https://unpkg.com/htmx.org@1.9.12" nonce={ templ.GetNonce(ctx) }></script>
        <!-- Alpine.js (deferred) -->
        <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/csp@3.x.x/dist/cdn.min.js" nonce={ templ.GetNonce(ctx) }></script>
    </head>
    <body class="bg-slate-50 font-sans antialiased text-gray-900" :class="modalOpen ? 'overflow-hidden h-screen' : ''" x-data="{ mobileMenu: false, modalOpen: false }" @modal-open.window="modalOpen = true" @modal-close.window="modalOpen = false">
        <div class="flex min-h-screen">
            <!-- Sidebar Layout -->
            <aside class="w-64 bg-slate-900 text-slate-300 fixed h-full flex flex-col justify-between z-40">
                <div class="p-6">
                    <h1 class="text-xl font-bold text-white tracking-wide">Sprezz Identity</h1>
                    <p class="text-xs text-slate-500 mt-1">{ props.TenantName }</p>

                    <nav class="mt-8 space-y-2">
                        <a href="/admin/tenants" class={ "block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors", templ.KV("bg-slate-800 text-white", props.CurrentTab == "tenants"), templ.KV("text-slate-400 hover:bg-slate-800 hover:text-white", props.CurrentTab != "tenants") }>Tenants</a>
                        <a href="/admin/clients" class={ "block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors", templ.KV("bg-slate-800 text-white", props.CurrentTab == "clients"), templ.KV("text-slate-400 hover:bg-slate-800 hover:text-white", props.CurrentTab != "clients") }>Applications</a>
                        <a href="/admin/idps" class={ "block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors", templ.KV("bg-slate-800 text-white", props.CurrentTab == "idps"), templ.KV("text-slate-400 hover:bg-slate-800 hover:text-white", props.CurrentTab != "idps") }>Identity Providers</a>
                        <a href="/admin/users" class={ "block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors", templ.KV("bg-slate-800 text-white", props.CurrentTab == "users"), templ.KV("text-slate-400 hover:bg-slate-800 hover:text-white", props.CurrentTab != "users") }>Users</a>
                    </nav>
                </div>
            </aside>

            <!-- Main Layout Window Wrapper -->
            <div class="flex-1 pl-64 flex flex-col">
                <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-8 sticky top-0 z-30">
                    <h2 class="text-lg font-semibold text-gray-800">{ props.Title }</h2>
                    <div id="global-spinner" class="htmx-indicator animate-spin rounded-full h-5 w-5 border-b-2 border-blue-600"></div>
                </header>

                <main class="p-8 flex-1">
                    <!-- Dynamic view child template inject placeholder -->
                    { children... }
                </main>
            </div>
        </div>

        <!-- Target Container for Modals -->
        <div id="modal-container"></div>
    </body>
    </html>
}

templ InputField(label, name, typeValue, value, errorStr string) {
    <div class="mb-4">
        <label class="block text-sm font-medium text-slate-700 mb-1">{ label }</label>
        <input
            type={ typeValue }
            name={ name }
            value={ value }
            class={ "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", templ.KV("border-red-500 focus:ring-red-500 focus:border-red-500", errorStr != ""), templ.KV("border-slate-300", errorStr == "") }
        />
        if errorStr != "" {
            <p class="text-xs text-red-500 mt-1">{ errorStr }</p>
        }
    </div>
}

templ StatusBadge(isActive bool) {
    if isActive {
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
            Active
        </span>
    } else {
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 border border-red-200">
            Locked
        </span>
    }
}

templ VerifiedBadge(isVerified bool) {
    if isVerified {
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
            Verified
        </span>
    } else {
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 border border-gray-200">
            Unverified
        </span>
    }
}

templ Modal(title, fetchUrl string) {
    <div
        x-data="{ isOpen: true }"
        x-show="isOpen"
        class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm"
        @keydown.escape.window="isOpen = false"
    >
        <div
            class="bg-white rounded-xl shadow-xl w-full max-w-lg overflow-hidden flex flex-col transform transition-all"
            @click.outside="isOpen = false"
        >
            <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
                <h3 class="text-lg font-bold text-slate-800">{ title }</h3>
                <button
                    type="button"
                    class="text-slate-400 hover:text-slate-600 transition"
                    @click="isOpen = false"
                >
                    ✕
                </button>
            </div>
            <div id="modal-body" class="p-6 overflow-y-auto max-h-[70vh]" hx-get={ fetchUrl } hx-trigger="load">
                <div class="flex justify-center py-8">
                    <svg class="animate-spin h-8 w-8 text-blue-500" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>
}

type AdminDashboardProps struct {
    ActiveTenant  model.Tenant
    IsAdminTenant bool
    Msg           string
}

templ AdminDashboard(props AdminDashboardProps) {
    @AdminLayout(AdminLayoutProps{Title: "Dashboard", CurrentTab: "dashboard", TenantName: props.ActiveTenant.Name}) {
        <div class="space-y-6">
            if props.Msg != "" {
                <div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
                    { props.Msg }
                </div>
            }

            if props.IsAdminTenant {
                <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden p-6 space-y-4">
                    <div class="flex items-center justify-between border-b border-gray-200 pb-3">
                        <h3 class="font-bold text-gray-800">Administrative Lockdown Panel</h3>
                        @StatusBadge(props.ActiveTenant.Config.AllowSignup)
                    </div>
                    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                        <div>
                            <p class="text-sm font-semibold text-slate-800">Public Registration State</p>
                            <p class="text-sm text-slate-500 mt-1">
                                When public registration is Active, new administrative user profiles can self-register. Turn this Off to secure your admin partition permanently.
                            </p>
                        </div>
                        <div>
                            <button
                                hx-patch={ fmt.Sprintf("/admin/tenants/%s/toggle-signup", props.ActiveTenant.ID.String()) }
                                class={ "px-4 py-2 rounded-lg font-semibold text-sm transition shadow-sm", templ.KV("bg-red-600 text-white hover:bg-red-700", props.ActiveTenant.Config.AllowSignup), templ.KV("bg-green-600 text-white hover:bg-green-700", !props.ActiveTenant.Config.AllowSignup) }
                            >
                                if props.ActiveTenant.Config.AllowSignup {
                                    Turn Off Registration
                                } else {
                                    Turn On Registration
                                }
                            </button>
                        </div>
                    </div>
                </div>
            } else {
                <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden p-6 text-center space-y-2">
                    <h3 class="text-xl font-bold text-gray-800">Welcome to Sprezz Identity</h3>
                    <p class="text-gray-500">You are logged into the administration console for tenant <span class="font-semibold text-gray-700">{ props.ActiveTenant.Name }</span>.</p>
                </div>
            }
        </div>
    }
}

type TenantsPageProps struct {
    ActiveTenant  model.Tenant
    IsAdminTenant bool
    Tenants       []model.Tenant
    Errors        map[string]string
    Msg           string
}

templ TenantsPage(props TenantsPageProps) {
    @AdminLayout(AdminLayoutProps{Title: "Tenants", CurrentTab: "tenants", TenantName: props.ActiveTenant.Name}) {
        <div class="space-y-6">
            if props.Msg != "" {
                <div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
                    { props.Msg }
                </div>
            }

            if props.IsAdminTenant {
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- Left: Tenant list -->
                    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
                        <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
                            <h3 class="font-bold text-gray-800">System Tenants</h3>
                            <button
                                hx-get="/admin/tenants/new?modal=true"
                                hx-target="#modal-container"
                                class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm"
                            >
                                + Create Tenant
                            </button>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200 text-sm">
                                <thead>
                                    <tr class="bg-gray-50 text-gray-500 font-semibold border-b border-gray-200">
                                        <th class="px-6 py-3 text-left">Name</th>
                                        <th class="px-6 py-3 text-left">Domain</th>
                                        <th class="px-6 py-3 text-left">Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200">
                                    for _, t := range props.Tenants {
                                        <tr class="hover:bg-gray-50 transition">
                                            <td class="px-6 py-4 font-medium text-gray-900">{ t.Name }</td>
                                            <td class="px-6 py-4 text-gray-500">{ t.Domain }</td>
                                            <td class="px-6 py-4">
                                                @StatusBadge(t.IsActive)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Right: Admin Tenant Settings -->
                    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden p-6 space-y-4">
                        <h3 class="font-bold text-gray-800 border-b border-gray-200 pb-3">Administrative Tenant Settings</h3>
                        <form hx-post="/admin/tenants/settings" hx-indicator="#global-spinner" class="space-y-4">
                            @InputField("Tenant Name", "name", "text", props.ActiveTenant.Name, props.Errors["name"])
                            @InputField("Canonical Domain", "domain", "text", props.ActiveTenant.Domain, props.Errors["domain"])
                            @InputField("Default Redirect URI", "default_redirect_uri", "text", props.ActiveTenant.Config.DefaultRedirectURI, props.Errors["default_redirect_uri"])
                            @InputField("Redirect Whitelist (comma-separated)", "redirect_whitelist", "text", strings.Join(props.ActiveTenant.Config.RedirectWhitelist, ", "), props.Errors["redirect_whitelist"])
                            @InputField("Predefined Scopes (comma-separated)", "predefined_scopes", "text", strings.Join(props.ActiveTenant.Config.PredefinedScopes, ", "), props.Errors["predefined_scopes"])
                            @InputField("Predefined Audiences (comma-separated)", "predefined_audiences", "text", strings.Join(props.ActiveTenant.Config.PredefinedAudiences, ", "), props.Errors["predefined_audiences"])

                            <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                                <div>
                                    <p class="text-sm font-semibold text-gray-800">Public Registration State</p>
                                    <p class="text-xs text-gray-500">Allow self-registration for global administrators.</p>
                                </div>
                                <button
                                    type="button"
                                    hx-patch={ fmt.Sprintf("/admin/tenants/%s/toggle-signup", props.ActiveTenant.ID.String()) }
                                    class={ "px-3 py-1.5 rounded-lg text-sm font-semibold transition", templ.KV("bg-red-600 text-white hover:bg-red-700", props.ActiveTenant.Config.AllowSignup), templ.KV("bg-green-600 text-white hover:bg-green-700", !props.ActiveTenant.Config.AllowSignup) }
                                >
                                    if props.ActiveTenant.Config.AllowSignup {
                                        Disable Signup
                                    } else {
                                        Enable Signup
                                    }
                                </button>
                            </div>

                            <div class="flex justify-end pt-4">
                                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm">
                                    Save Settings
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            } else {
                <!-- Normal Tenant Settings Only -->
                <div class="max-w-2xl mx-auto bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden p-6 space-y-4">
                    <h3 class="font-bold text-gray-800 border-b border-gray-200 pb-3">Tenant Configuration Settings</h3>
                    <form hx-post="/admin/tenants/settings" hx-indicator="#global-spinner" class="space-y-4">
                        @InputField("Tenant Name", "name", "text", props.ActiveTenant.Name, props.Errors["name"])
                        @InputField("Canonical Domain", "domain", "text", props.ActiveTenant.Domain, props.Errors["domain"])
                        @InputField("Default Redirect URI", "default_redirect_uri", "text", props.ActiveTenant.Config.DefaultRedirectURI, props.Errors["default_redirect_uri"])
                        @InputField("Redirect Whitelist (comma-separated)", "redirect_whitelist", "text", strings.Join(props.ActiveTenant.Config.RedirectWhitelist, ", "), props.Errors["redirect_whitelist"])
                        @InputField("Predefined Scopes (comma-separated)", "predefined_scopes", "text", strings.Join(props.ActiveTenant.Config.PredefinedScopes, ", "), props.Errors["predefined_scopes"])
                        @InputField("Predefined Audiences (comma-separated)", "predefined_audiences", "text", strings.Join(props.ActiveTenant.Config.PredefinedAudiences, ", "), props.Errors["predefined_audiences"])

                        <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                            <div>
                                <p class="text-sm font-semibold text-gray-800">Public Registration State</p>
                                <p class="text-xs text-gray-500">Allow self-registration for users in this tenant partition.</p>
                            </div>
                            <button
                                type="button"
                                hx-patch={ fmt.Sprintf("/admin/tenants/%s/toggle-signup", props.ActiveTenant.ID.String()) }
                                class={ "px-3 py-1.5 rounded-lg text-sm font-semibold transition", templ.KV("bg-red-600 text-white hover:bg-red-700", props.ActiveTenant.Config.AllowSignup), templ.KV("bg-green-600 text-white hover:bg-green-700", !props.ActiveTenant.Config.AllowSignup) }
                            >
                                if props.ActiveTenant.Config.AllowSignup {
                                    Disable Signup
                                } else {
                                    Enable Signup
                                }
                            </button>
                        </div>

                        <div class="flex justify-end pt-4">
                            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm">
                                Save Configuration
                            </button>
                        </div>
                    </form>
                </div>
            }
        </div>
    }
}

templ CreateTenantForm(errors map[string]string) {
    <form hx-post="/admin/tenants" hx-target="#modal-body" class="space-y-4">
        @InputField("Tenant Name", "name", "text", "", errors["name"])
        @InputField("Canonical Domain", "domain", "text", "", errors["domain"])
        <div class="flex justify-end space-x-3 pt-4 border-t border-slate-200">
            <button
                type="button"
                class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition"
                @click="isOpen = false"
            >
                Cancel
            </button>
            <button
                type="submit"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition"
            >
                Create Tenant
            </button>
        </div>
    </form>
}

type ClientsPageProps struct {
    ActiveTenant model.Tenant
    Clients      []model.ClientApplication
    Msg          string
}

templ ClientsPage(props ClientsPageProps) {
    @AdminLayout(AdminLayoutProps{Title: "Applications", CurrentTab: "clients", TenantName: props.ActiveTenant.Name}) {
        <div class="space-y-6">
            if props.Msg != "" {
                <div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
                    { props.Msg }
                </div>
            }

            <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
                <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
                    <h3 class="font-bold text-gray-800">OIDC Applications</h3>
                    <button
                        hx-get="/admin/clients/new?modal=true"
                        hx-target="#modal-container"
                        class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm"
                    >
                        + New Application
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 text-sm">
                        <thead>
                            <tr class="bg-gray-50 text-gray-500 font-semibold border-b border-gray-200">
                                <th class="px-6 py-3 text-left">Client ID</th>
                                <th class="px-6 py-3 text-left">Application Name</th>
                                <th class="px-6 py-3 text-left">Type</th>
                                <th class="px-6 py-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            for _, c := range props.Clients {
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="px-6 py-4 font-mono font-medium text-gray-900">{ c.ClientID }</td>
                                    <td class="px-6 py-4 text-gray-500">{ c.ClientName }</td>
                                    <td class="px-6 py-4 text-gray-500 capitalize">{ string(c.ClientType) }</td>
                                    <td class="px-6 py-4 text-right space-x-2">
                                        <button
                                            hx-get={ fmt.Sprintf("/admin/clients/view?id=%s&modal=true", c.ClientID) }
                                            hx-target="#modal-container"
                                            class="text-blue-600 hover:text-blue-800 font-medium"
                                        >
                                            View
                                        </button>
                                        <button
                                            hx-get={ fmt.Sprintf("/admin/clients/edit?id=%s&modal=true", c.ClientID) }
                                            hx-target="#modal-container"
                                            class="text-green-600 hover:text-green-800 font-medium"
                                        >
                                            Edit
                                        </button>
                                        <button
                                            hx-delete={ fmt.Sprintf("/admin/clients/%s", c.ClientID) }
                                            hx-confirm={ fmt.Sprintf("Are you sure you want to delete application '%s'?", c.ClientName) }
                                            hx-target="body"
                                            class="text-red-600 hover:text-red-800 font-medium"
                                        >
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

type ClientFormProps struct {
    Client   model.ClientApplication
    Errors   map[string]string
    IsEdit   bool
    ReadOnly bool
}

templ ClientForm(props ClientFormProps) {
    <form hx-post="/admin/clients" hx-target="#modal-body" class="space-y-4">
        @InputField("Application Name", "client_name", "text", props.Client.ClientName, props.Errors["client_name"])

        if props.IsEdit {
            <input type="hidden" name="id" value={ props.Client.ID }/>
            <input type="hidden" name="client_id" value={ props.Client.ClientID }/>
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-500 mb-1">Client ID</label>
                <div class="font-mono text-gray-800 bg-gray-50 px-3 py-2 border border-slate-300 rounded-lg">{ props.Client.ClientID }</div>
            </div>
        } else {
            @InputField("Client ID", "client_id", "text", props.Client.ClientID, props.Errors["client_id"])
        }

        <div class="mb-4">
            <label class="block text-sm font-medium text-slate-700 mb-1">Client Type</label>
            <select name="client_type" class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <option value="confidential" selected?={ props.Client.ClientType == "confidential" }>Confidential</option>
                <option value="public" selected?={ props.Client.ClientType == "public" }>Public</option>
            </select>
        </div>

        @InputField("OIDC Redirect URIs (comma-separated)", "redirect_uris", "text", strings.Join(props.Client.RedirectURIs, ", "), props.Errors["redirect_uris"])
        @InputField("Post-Logout Redirect URIs (comma-separated)", "post_logout_redirect_uris", "text", strings.Join(props.Client.PostLogoutRedirectURIs, ", "), props.Errors["post_logout_redirect_uris"])
        @InputField("Front-Channel Logout URI", "front_channel_logout_uri", "text", props.Client.FrontChannelLogoutURI, props.Errors["front_channel_logout_uri"])
        @InputField("Back-Channel Logout URI", "back_channel_logout_uri", "text", props.Client.BackChannelLogoutURI, props.Errors["back_channel_logout_uri"])

        <div class="flex justify-end space-x-3 pt-4 border-t border-slate-200">
            <button
                type="button"
                class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition"
                @click="isOpen = false"
            >
                Close
            </button>
            if !props.ReadOnly {
                <button
                    type="submit"
                    class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition"
                >
                    if props.IsEdit {
                        Save Changes
                    } else {
                        Create Application
                    }
                </button>
            }
        </div>
    </form>
}

type IDPsPageProps struct {
    ActiveTenant model.Tenant
    Providers    []model.IdentityProvider
    Msg          string
}

templ IDPsPage(props IDPsPageProps) {
    @AdminLayout(AdminLayoutProps{Title: "Identity Providers", CurrentTab: "idps", TenantName: props.ActiveTenant.Name}) {
        <div class="space-y-6">
            if props.Msg != "" {
                <div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
                    { props.Msg }
                </div>
            }

            <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
                <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
                    <h3 class="font-bold text-gray-800">Identity Providers</h3>
                    <button
                        hx-get="/admin/idps/new?modal=true"
                        hx-target="#modal-container"
                        class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm"
                    >
                        + Add Provider
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 text-sm">
                        <thead>
                            <tr class="bg-gray-50 text-gray-500 font-semibold border-b border-gray-200">
                                <th class="px-6 py-3 text-left">Alias</th>
                                <th class="px-6 py-3 text-left">Type</th>
                                <th class="px-6 py-3 text-left">Status</th>
                                <th class="px-6 py-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            for _, p := range props.Providers {
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="px-6 py-4 font-medium text-gray-900">{ p.Alias }</td>
                                    <td class="px-6 py-4 text-gray-500 capitalize">{ p.IDPType }</td>
                                    <td class="px-6 py-4">
                                        @StatusBadge(p.Enabled)
                                    </td>
                                    <td class="px-6 py-4 text-right space-x-2">
                                        <button
                                            hx-get={ fmt.Sprintf("/admin/idps/edit?id=%s&modal=true", p.ID.String()) }
                                            hx-target="#modal-container"
                                            class="text-green-600 hover:text-green-800 font-medium"
                                        >
                                            Edit
                                        </button>
                                        <button
                                            hx-delete={ fmt.Sprintf("/admin/idps/%s", p.ID.String()) }
                                            hx-confirm={ fmt.Sprintf("Are you sure you want to delete identity provider '%s'?", p.Alias) }
                                            hx-target="body"
                                            class="text-red-600 hover:text-red-800 font-medium"
                                        >
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

type IDPFormProps struct {
    Provider model.IdentityProvider
    Errors   map[string]string
    IsEdit   bool
}

templ IDPForm(props IDPFormProps) {
    <form hx-post="/admin/idps" hx-target="#modal-body" class="space-y-4">
        if props.IsEdit {
            <input type="hidden" name="id" value={ props.Provider.ID.String() }/>
            <input type="hidden" name="idp_type" value={ props.Provider.IDPType }/>
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-500 mb-1">Provider Type</label>
                <div class="font-semibold text-gray-800 bg-gray-50 px-3 py-2 border border-slate-300 rounded-lg capitalize">{ props.Provider.IDPType }</div>
            </div>
        } else {
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-1">Provider Type</label>
                <select name="idp_type" class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    <option value="username-password">Username Password</option>
                    <option value="oidc">OpenID Connect</option>
                    <option value="saml">SAML 2.0</option>
                </select>
            </div>
        }

        @InputField("Alias", "alias", "text", props.Provider.Alias, props.Errors["alias"])

        <div class="flex items-center space-x-3 mb-4">
            <input
                type="checkbox"
                id="enabled"
                name="enabled"
                value="true"
                checked?={ props.Provider.Enabled }
                class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
            />
            <label for="enabled" class="text-sm font-medium text-slate-700">Enabled</label>
        </div>

        <div class="mb-4">
            <label class="block text-sm font-medium text-slate-700 mb-1">Username Field Mapping</label>
            <select name="username_field" class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <option value="preferredUsername" selected?={ props.Provider.Config.UsernameField == "preferredUsername" }>Username (preferredUsername)</option>
                <option value="email" selected?={ props.Provider.Config.UsernameField == "email" }>Email</option>
            </select>
        </div>

        <div class="mb-4">
            <label class="block text-sm font-medium text-slate-700 mb-1">Identity Assurance Level (IAL)</label>
            <select name="ial" class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <option value="0" selected?={ props.Provider.Config.IAL == 0 }>IAL 0</option>
                <option value="1" selected?={ props.Provider.Config.IAL == 1 }>IAL 1</option>
                <option value="2" selected?={ props.Provider.Config.IAL == 2 }>IAL 2</option>
                <option value="3" selected?={ props.Provider.Config.IAL == 3 }>IAL 3</option>
            </select>
        </div>

        <div class="mb-4">
            <label class="block text-sm font-medium text-slate-700 mb-1">Authenticator Assurance Level (AAL)</label>
            <select name="aal" class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <option value="0" selected?={ props.Provider.Config.AAL == 0 }>AAL 0</option>
                <option value="1" selected?={ props.Provider.Config.AAL == 1 }>AAL 1</option>
                <option value="2" selected?={ props.Provider.Config.AAL == 2 }>AAL 2</option>
                <option value="3" selected?={ props.Provider.Config.AAL == 3 }>AAL 3</option>
            </select>
        </div>

        <div class="flex justify-end space-x-3 pt-4 border-t border-slate-200">
            <button
                type="button"
                class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition"
                @click="isOpen = false"
            >
                Cancel
            </button>
            <button
                type="submit"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition"
            >
                if props.IsEdit {
                    Save Changes
                } else {
                    Create Provider
                }
            </button>
        </div>
    </form>
}

type UsersPageProps struct {
    ActiveTenant model.Tenant
    Users        []model.UserProfile
    Msg          string
}

templ UsersPage(props UsersPageProps) {
    @AdminLayout(AdminLayoutProps{Title: "Users", CurrentTab: "users", TenantName: props.ActiveTenant.Name}) {
        <div class="space-y-6">
            if props.Msg != "" {
                <div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
                    { props.Msg }
                </div>
            }

            <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
                <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
                    <h3 class="font-bold text-gray-800">User Profiles</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 text-sm">
                        <thead>
                            <tr class="bg-gray-50 text-gray-500 font-semibold border-b border-gray-200">
                                <th class="px-6 py-3 text-left">Username</th>
                                <th class="px-6 py-3 text-left">Name</th>
                                <th class="px-6 py-3 text-left">Email</th>
                                <th class="px-6 py-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            for _, u := range props.Users {
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="px-6 py-4 font-mono font-medium text-gray-900">{ u.PreferredUsername }</td>
                                    <td class="px-6 py-4 text-gray-500">{ u.Name }</td>
                                    <td class="px-6 py-4 text-gray-500">{ u.Email }</td>
                                    <td class="px-6 py-4 text-right space-x-2">
                                        <button
                                            hx-get={ fmt.Sprintf("/admin/users/view?id=%s&modal=true", u.ID.String()) }
                                            hx-target="#modal-container"
                                            class="text-blue-600 hover:text-blue-800 font-medium"
                                        >
                                            View
                                        </button>
                                        <button
                                            hx-get={ fmt.Sprintf("/admin/users/edit?id=%s&modal=true", u.ID.String()) }
                                            hx-target="#modal-container"
                                            class="text-green-600 hover:text-green-800 font-medium"
                                        >
                                            Edit
                                        </button>
                                        <button
                                            hx-delete={ fmt.Sprintf("/admin/users/%s", u.ID.String()) }
                                            hx-confirm={ fmt.Sprintf("Are you sure you want to delete user '%s'?", u.PreferredUsername) }
                                            hx-target="body"
                                            class="text-red-600 hover:text-red-800 font-medium"
                                        >
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

type UserFormProps struct {
    User   model.UserProfile
    Errors map[string]string
}

templ UserForm(props UserFormProps) {
    <form hx-post="/admin/users" hx-target="#modal-body" class="space-y-4">
        <input type="hidden" name="id" value={ props.User.ID.String() }/>

        @InputField("Username", "preferred_username", "text", props.User.PreferredUsername, props.Errors["preferred_username"])
        @InputField("Full Name", "name", "text", props.User.Name, props.Errors["name"])
        @InputField("Email", "email", "email", props.User.Email, props.Errors["email"])

        <div class="flex items-center space-x-3 mb-4">
            <input
                type="checkbox"
                id="email_verified"
                name="email_verified"
                value="true"
                checked?={ props.User.EmailVerified }
                class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
            />
            <label for="email_verified" class="text-sm font-medium text-slate-700">Email Verified</label>
        </div>

        <div class="flex justify-end space-x-3 pt-4 border-t border-slate-200">
            <button
                type="button"
                class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition"
                @click="isOpen = false"
            >
                Cancel
            </button>
            <button
                type="submit"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition"
            >
                Save Changes
            </button>
        </div>
    </form>
}

type UserDetailsProps struct {
    User       model.UserProfile
    Identities []model.UserIdentity
    Providers  []model.IdentityProvider
}

templ UserDetails(props UserDetailsProps) {
    <div class="space-y-6">
        <!-- Profile info summary -->
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-100 grid grid-cols-2 gap-4 text-sm">
            <div>
                <p class="text-xs text-slate-500 font-semibold uppercase">Preferred Username</p>
                <p class="font-mono text-gray-800 font-medium">{ props.User.PreferredUsername }</p>
            </div>
            <div>
                <p class="text-xs text-slate-500 font-semibold uppercase">Full Name</p>
                <p class="text-gray-800 font-medium">{ props.User.Name }</p>
            </div>
            <div>
                <p class="text-xs text-slate-500 font-semibold uppercase">Email</p>
                <p class="text-gray-800 font-medium">{ props.User.Email }</p>
            </div>
            <div>
                <p class="text-xs text-slate-500 font-semibold uppercase">Email Verified</p>
                @VerifiedBadge(props.User.EmailVerified)
            </div>
        </div>

        <!-- Coupled identities section -->
        <div class="space-y-3">
            <h4 class="font-bold text-gray-800 text-sm border-b border-gray-200 pb-2">Coupled Identities</h4>
            if len(props.Identities) == 0 {
                <p class="text-sm text-gray-500">No identities coupled to this profile yet.</p>
            } else {
                <div class="space-y-3">
                    for _, ident := range props.Identities {
                        <div class="flex items-center justify-between p-3 border border-gray-200 rounded-lg text-sm">
                            <div>
                                <p class="font-semibold text-gray-800">
                                    for _, p := range props.Providers {
                                        if p.ID == ident.IdentityProviderID {
                                            { p.Alias } <span class="text-xs text-gray-400 capitalize">({ p.IDPType })</span>
                                        }
                                    }
                                </p>
                                <p class="font-mono text-xs text-gray-500 mt-1">External Sub/ID: { ident.ExternalIdentityID }</p>
                                <p class="text-xs text-gray-500">Login Count: { fmt.Sprintf("%d", ident.LoginCount) } | Blocked: { fmt.Sprintf("%t", ident.Blocked) }</p>
                                <p class="text-xs text-gray-400 mt-0.5">Coupled at: { ident.CoupledAt.Format("2006-01-02 15:04:05") }</p>
                            </div>
                            <button
                                hx-delete={ fmt.Sprintf("/admin/users/%s/identities/%s", props.User.ID.String(), ident.IdentityProviderID.String()) }
                                hx-confirm="Are you sure you want to decouple this identity from the user's profile?"
                                hx-target="#modal-body"
                                class="px-2.5 py-1.5 bg-red-50 text-red-600 hover:bg-red-100 rounded-lg text-xs font-semibold transition"
                            >
                                Decouple
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex justify-end pt-4 border-t border-slate-200">
            <button
                type="button"
                class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition"
                @click="isOpen = false"
            >
                Close
            </button>
        </div>
    </div>
}
