package views

import (
    "fmt"
    "time"
    "encoding/json"
    "sprezz-identity/internal/domain/model"
)

func marshalProviders(providers []model.IdentityProvider) string {
    type IDPInfo struct {
        ID    string `json:"id"`
        Alias string `json:"alias"`
    }
    list := []IDPInfo{{ID: "username-password", Alias: "Local Accounts"}}
    for _, p := range providers {
        if p.IDPType != "username-password" {
            list = append(list, IDPInfo{ID: p.ID.String(), Alias: p.Alias})
        }
    }
    bytes, err := json.Marshal(list)
    if err != nil {
        return "[]"
    }
    return string(bytes)
}

func getInitialClientType(clientType string) string {
    if clientType == "" {
        return "confidential"
    }
    return clientType
}

func hasGrantType(grantTypes []string, target string, def bool) bool {
    if len(grantTypes) == 0 {
        return def
    }
    for _, gt := range grantTypes {
        if gt == target {
            return true
        }
    }
    return false
}

func marshalStringSlice(slice []string) string {
    if len(slice) == 0 {
        return "[]"
    }
    bytes, _ := json.Marshal(slice)
    return string(bytes)
}

type AdminLayoutProps struct {
    Title       string
    CurrentTab  string
    TenantName  string
}

type NavItem struct {
    Label string
    URL   string
    Key   string
}

var navItems = []NavItem{
    {Label: "Tenants", URL: "/admin/tenants", Key: "tenants"},
    {Label: "Applications", URL: "/admin/clients", Key: "clients"},
    {Label: "Identity Providers", URL: "/admin/idps", Key: "idps"},
    {Label: "Users", URL: "/admin/users", Key: "users"},
}

templ AdminLayout(props AdminLayoutProps) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>{ props.Title } | Sprezz Identity Admin</title>
        <!-- Tailwind CSS -->
        <script src="https://cdn.tailwindcss.com" nonce={ templ.GetNonce(ctx) }></script>
        <!-- HTMX -->
        <script src="https://unpkg.com/htmx.org@1.9.12" nonce={ templ.GetNonce(ctx) }></script>
        <!-- Alpine.js (deferred) -->
        <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/csp@3.x.x/dist/cdn.min.js" nonce={ templ.GetNonce(ctx) }></script>
        <!-- Nonced Alpine CSP Helpers -->
        <script nonce={ templ.GetNonce(ctx) }>
            function purgeModal(el) {
                el.dispatchEvent(new CustomEvent('modal-close', { bubbles: true }));
                el.remove();
            }
            document.addEventListener('DOMContentLoaded', () => {
                // 1. HTMX Component Discovery Bridge
                document.body.addEventListener('htmx:afterSwap', (event) => {
                    if (window.Alpine && event.detail.target) {
                        if (typeof window.Alpine.initTree === 'function') {
                            window.Alpine.initTree(event.detail.target);
                        } else if (typeof window.Alpine.processTree === 'function') {
                            window.Alpine.processTree(event.detail.target);
                        }
                    }
                });
            });

            document.addEventListener('alpine:init', () => {
                Alpine.data('urlManager', (initialUrls) => ({
                    urls: initialUrls || [],
                    newUrl: '',
                    error: '',
                    addUrl() {
                        this.error = '';
                        const trimmed = this.newUrl.trim();
                        if (!trimmed) return;
                        try {
                            new URL(trimmed);
                            if (!this.urls.includes(trimmed)) {
                                this.urls.push(trimmed);
                            }
                            this.newUrl = '';
                        } catch (e) {
                            this.error = 'Invalid URL format (must include protocol like http:// or https://)';
                        }
                    },
                    removeUrl(index) {
                        this.urls.splice(index, 1);
                    }
                }));

                // 2. CSP-Compliant Scopes Component Manager
                Alpine.data('scopesManager', () => ({
                    builtIn: ['openid', 'profile', 'email', 'offline_access'],
                    selectedBuiltIn: [],
                    customTags: [],
                    newTag: '',
                    error: '',
                    inputName: 'scopes',

                    init() {
                        this.inputName = this.$el.dataset.inputName || 'scopes';
                        let initList = [];
                        try {
                            initList = JSON.parse(this.$el.dataset.initialScopes) || [];
                        } catch(e) {
                            initList = [];
                        }

                        initList.forEach(s => {
                            if (this.builtIn.includes(s)) {
                                this.selectedBuiltIn.push(s);
                            } else if (s.trim() !== '') {
                                this.customTags.push(s.trim());
                            }
                        });
                    },
                    addTag() {
                        this.error = '';
                        const trimmed = this.newTag.trim();
                        if (!trimmed) return;
                        if (this.builtIn.includes(trimmed)) {
                            if (!this.selectedBuiltIn.includes(trimmed)) {
                                this.selectedBuiltIn.push(trimmed);
                            }
                            this.newTag = '';
                            return;
                        }
                        if (this.customTags.includes(trimmed)) {
                            this.error = 'Scope already exists';
                            return;
                        }
                        this.customTags.push(trimmed);
                        this.newTag = '';
                    },
                    removeTag(index) {
                        this.customTags.splice(index, 1);
                    }
                }));

                // 3. CSP-Compliant Audiences Component Manager
                Alpine.data('audiencesManager', () => ({
                    audiences: [],
                    newAudience: '',
                    error: '',
                    inputName: 'audiences',

                    init() {
                        this.inputName = this.$el.dataset.inputName || 'audiences';
                        try {
                            this.audiences = JSON.parse(this.$el.dataset.initialAudiences) || [];
                        } catch(e) {
                            this.audiences = [];
                        }
                    },
                    addAudience() {
                        this.error = '';
                        const trimmed = this.newAudience.trim();
                        if (!trimmed) return;
                        if (trimmed.includes(' ') || (!trimmed.includes('://') && !/^[a-zA-Z0-9_:-]+$/.test(trimmed))) {
                            this.error = 'Must be an absolute URI or valid system identifier';
                            return;
                        }
                        if (this.audiences.includes(trimmed)) {
                            this.error = 'Audience already exists';
                            return;
                        }
                        this.audiences.push(trimmed);
                        this.newAudience = '';
                    },
                    removeAudience(index) {
                        this.audiences.splice(index, 1);
                    }
                }));

                Alpine.data('lifetimeCalculator', (initialSeconds) => ({
                    seconds: initialSeconds || 3600,
                    value: 1,
                    unit: 'hours',
                    init() {
                        const totalSec = parseInt(this.seconds) || 0;
                        if (totalSec % 86400 === 0 && totalSec > 0) {
                            this.value = totalSec / 86400;
                            this.unit = 'days';
                        } else if (totalSec % 3600 === 0 && totalSec > 0) {
                            this.value = totalSec / 3600;
                            this.unit = 'hours';
                        } else if (totalSec % 60 === 0 && totalSec > 0) {
                            this.value = totalSec / 60;
                            this.unit = 'minutes';
                        } else {
                            this.value = totalSec;
                            this.unit = 'seconds';
                        }
                    },
                    updateSeconds() {
                        const val = parseFloat(this.value) || 0;
                        let multiplier = 1;
                        if (this.unit === 'minutes') multiplier = 60;
                        else if (this.unit === 'hours') multiplier = 3600;
                        else if (this.unit === 'days') multiplier = 86400;
                        this.seconds = Math.round(val * multiplier);
                    },
                    snapToPublicDefault() {
                        this.value = 1;
                        this.unit = 'days';
                        this.updateSeconds();
                    }
                }));

                Alpine.data('idpRouter', (initialAllowed, allProviders) => ({
                    allProviders: allProviders || [],
                    allowed: initialAllowed || [],
                    init() {
                        // Keep initial selection
                    }
                }));

                Alpine.data('secretGenerator', (initialSecret) => ({
                    secret: initialSecret || '',
                    generate() {
                        const bytes = new Uint8Array(32);
                        window.crypto.getRandomValues(bytes);
                        let binary = '';
                        for (let i = 0; i < 32; i++) {
                            binary += String.fromCharCode(bytes[i]);
                        }
                        this.secret = btoa(binary)
                            .replace(/\+/g, '-')
                            .replace(/\//g, '_')
                            .replace(/=/g, '');
                    }
                }));

                Alpine.data('clientFormManager', (initialType, initialAuthCode, initialClientCredentials, initialIdpCount) => ({
                    clientType: initialType || 'confidential',
                    authCode: !!initialAuthCode,
                    clientCredentials: !!initialClientCredentials,
                    idpCount: parseInt(initialIdpCount) || 0,
                    isSubmitDisabled: false,

                    init() {
                        this.checkSubmit();
                        this.$watch('clientType', (val) => {
                            if (val === 'public') {
                                this.clientCredentials = false;
                                this.authCode = true;
                                this.$dispatch('client-type-public');
                            }
                            this.checkSubmit();
                        });
                        this.$watch('authCode', (val) => { this.checkSubmit(); });
                        this.$watch('clientCredentials', (val) => { this.checkSubmit(); });
                    },

                    checkSubmit() {
                        if (this.clientType === 'public' || this.authCode) {
                            this.isSubmitDisabled = (this.idpCount === 0);
                        } else {
                            this.isSubmitDisabled = false;
                        }
                    },

                    handleClientType(type) {
                        this.clientType = type;
                    },

                    handleAuthCodeChange(checked) {
                        this.authCode = checked;
                        this.checkSubmit();
                        this.$dispatch('grant-type-change', { authCode: checked });
                    },

                    handleClientCredentialsChange(checked) {
                        this.clientCredentials = checked;
                        this.checkSubmit();
                    },

                    handleIdpChange(count) {
                        this.idpCount = count;
                    }
                }));

                Alpine.data('idpRouter', (initialAllowed, availablePool, initialDefaultIdp) => ({
                    allowedIds: initialAllowed || [],
                    defaultId: initialDefaultIdp || '',
                    available: availablePool || [],
                    allowedList: [],
                    isInvalidState: false,

                    init() {
                        this.updateAllowedList();
                    },

                    toggleIdp(id) {
                        if (this.allowedIds.includes(id)) {
                            this.allowedIds = this.allowedIds.filter(x => x !== id);
                            if (this.defaultId === id) this.defaultId = '';
                        } else {
                            this.allowedIds.push(id);
                        }
                        this.updateAllowedList();
                    },

                    updateAllowedList() {
                        let list = [];
                        if (this.allowedIds.includes('username-password')) {
                            list.push({ id: 'username-password', name: 'Local Accounts' });
                        }
                        this.available.forEach(p => {
                            if (this.allowedIds.includes(p.id)) {
                                list.push({ id: p.id, name: p.name });
                            }
                        });
                        this.allowedList = list;
                        this.isInvalidState = (this.allowedIds.length === 0);

                        this.$dispatch('idp-count-update', { count: this.allowedIds.length });
                    }
                }));

                // 4. CSP-Compliant Single URI Input Validator
                Alpine.data('uriValidator', (initialValue) => ({
                    value: initialValue || '',
                    error: '',
                    validate() {
                        const trimmed = this.value.trim();
                        if (!trimmed) {
                            this.error = '';
                            return;
                        }
                        if (!trimmed.includes('://')) {
                            this.error = 'Invalid URL format (must include protocol like http:// or https://)';
                        } else {
                            this.error = '';
                        }
                    }
                }));

                // 5. CSP-Compliant Modal Controller
                Alpine.data('modalController', () => ({
                    isOpen: true,
                    init() {
                        this.$dispatch('modal-open');
                    },
                    close() {
                        this.isOpen = false;
                        window.setTimeout(purgeModal, 200, this.$el);
                    }
                }));

                // 6. CSP-Compliant Async ID & Secret Generator
                Alpine.data('idSecretGenerator', (initialVal) => ({
                    value: initialVal || '',
                    showSecret: false,
                    generate() {
                        window.fetch('/admin/clients/generate-secret')
                            .then(response => response.text())
                            .then(text => {
                                this.value = text;
                            });
                    },
                    toggleShow() {
                        this.showSecret = !this.showSecret;
                    }
                }));
            });
        </script>
    </head>
    <body class="bg-slate-50 font-sans antialiased text-gray-900" :class="modalOpen ? 'overflow-hidden h-screen' : ''" x-data={ fmt.Sprintf("{ mobileMenu: false, modalOpen: false, currentTab: '%s' }", props.CurrentTab) } @modal-open.window="modalOpen = true" @modal-close.window="modalOpen = false">
        <div class="flex min-h-screen">
            <!-- Sidebar Layout -->
            <aside class="w-64 bg-slate-900 text-slate-300 fixed h-full flex flex-col justify-between z-40">
                <div class="p-6">
                    <h1 class="text-xl font-bold text-white tracking-wide">Sprezz Identity</h1>
                    <p class="text-xs text-slate-500 mt-1">{ props.TenantName }</p>

                    <nav class="mt-8 space-y-2">
                        for _, item := range navItems {
                            <a
                                href={ item.URL }
                                hx-get={ item.URL }
                                hx-target="main"
                                hx-swap="innerHTML"
                                hx-push-url="true"
                                @click={ fmt.Sprintf("currentTab = '%s'", item.Key) }
                                class="block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors"
                                :class={ fmt.Sprintf("currentTab == '%s' ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-white'", item.Key) }
                            >
                                { item.Label }
                            </a>
                        }
                    </nav>
                </div>
            </aside>

            <!-- Main Layout Window Wrapper -->
            <div class="flex-1 pl-64 flex flex-col">
                <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-8 sticky top-0 z-30">
                    <h2 class="text-lg font-semibold text-gray-800">{ props.Title }</h2>
                    <div id="global-spinner" class="htmx-indicator animate-spin rounded-full h-5 w-5 border-b-2 border-blue-600"></div>
                </header>

                <main class="p-8 flex-1">
                    <!-- Dynamic view child template inject placeholder -->
                    { children... }
                </main>
            </div>
        </div>

        <!-- Target Container for Modals -->
        <div id="modal-container"></div>
    </body>
    </html>
}

templ InputField(label, name, typeValue, value, errorStr string) {
    <div class="mb-4">
        <label class="block text-sm font-medium text-slate-700 mb-1">{ label }</label>
        <input
            type={ typeValue }
            name={ name }
            value={ value }
            class={ "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", templ.KV("border-red-500 focus:ring-red-500 focus:border-red-500", errorStr != ""), templ.KV("border-slate-300", errorStr == "") }
        />
        if errorStr != "" {
            <p class="text-xs text-red-500 mt-1">{ errorStr }</p>
        }
    </div>
}

templ URIInputField(label, name, value, errorStr string) {
    <div x-data={ fmt.Sprintf("uriValidator('%s')", value) } class="mb-4">
        <label class="block text-sm font-medium text-slate-700 mb-1">{ label }</label>
        <input
            type="text"
            name={ name }
            x-model="value"
            @input="validate()"
            class={ "w-full px-3 py-2 border rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500", templ.KV("border-red-500 focus:ring-red-500 focus:border-red-500", errorStr != ""), templ.KV("border-slate-300", errorStr == "") }
            :class="error ? 'border-red-500 focus:ring-red-500 focus:border-red-500' : ''"
        />
        <p x-show="error" class="text-xs text-red-500 mt-1" x-text="error" style="display: none;"></p>
        if errorStr != "" {
            <p x-show="!error" class="text-xs text-red-500 mt-1">{ errorStr }</p>
        }
    </div>
}

templ StatusBadge(isActive bool) {
    if isActive {
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
            Active
        </span>
    } else {
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 border border-red-200">
            Locked
        </span>
    }
}

templ IDPStatusBadge(isEnabled bool) {
    if isEnabled {
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
            Active
        </span>
    } else {
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 border border-gray-200">
            Inactive
        </span>
    }
}

templ VerifiedBadge(isVerified bool) {
    if isVerified {
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
            Verified
        </span>
    } else {
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 border border-gray-200">
            Unverified
        </span>
    }
}

templ Modal(title, fetchUrl string) {
    <div
        x-data="modalController"
        x-show="isOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm"
        @keydown.escape.window="close()"
    >
        <div
            class="bg-white rounded-xl shadow-xl w-full max-w-lg overflow-hidden flex flex-col transform transition-all"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
            x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
            x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
            @click.outside="close()"
        >
            <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between">
                <h3 class="text-lg font-bold text-slate-800">{ title }</h3>
                <button
                    type="button"
                    class="text-slate-400 hover:text-slate-600 transition"
                    @click="close()"
                >
                    ✕
                </button>
            </div>
            <div id="modal-body" class="p-6 overflow-y-auto max-h-[70vh]" hx-get={ fetchUrl } hx-trigger="load">
                <div class="flex justify-center py-8">
                    <svg class="animate-spin h-8 w-8 text-blue-500" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>
}

type AdminDashboardProps struct {
    ActiveTenant  model.Tenant
    IsAdminTenant bool
    Msg           string
}

templ AdminDashboard(props AdminDashboardProps) {
    @AdminLayout(AdminLayoutProps{Title: "Dashboard", CurrentTab: "dashboard", TenantName: props.ActiveTenant.Name}) {
        <div class="space-y-6">
            if props.Msg != "" {
                <div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
                    { props.Msg }
                </div>
            }

            if props.IsAdminTenant {
                <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden p-6 space-y-4">
                    <div class="flex items-center justify-between border-b border-gray-200 pb-3">
                        <h3 class="font-bold text-gray-800">Administrative Lockdown Panel</h3>
                        @StatusBadge(props.ActiveTenant.Config.AllowSignup)
                    </div>
                    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                        <div>
                            <p class="text-sm font-semibold text-slate-800">Public Registration State</p>
                            <p class="text-sm text-slate-500 mt-1">
                                When public registration is Active, new administrative user profiles can self-register. Turn this Off to secure your admin partition permanently.
                            </p>
                        </div>
                        <div>
                            <button
                                hx-patch={ fmt.Sprintf("/admin/tenants/%s/toggle-signup", props.ActiveTenant.ID.String()) }
                                class={ "px-4 py-2 rounded-lg font-semibold text-sm transition shadow-sm", templ.KV("bg-red-600 text-white hover:bg-red-700", props.ActiveTenant.Config.AllowSignup), templ.KV("bg-green-600 text-white hover:bg-green-700", !props.ActiveTenant.Config.AllowSignup) }
                            >
                                if props.ActiveTenant.Config.AllowSignup {
                                    Turn Off Registration
                                } else {
                                    Turn On Registration
                                }
                            </button>
                        </div>
                    </div>
                </div>
            } else {
                <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden p-6 text-center space-y-2">
                    <h3 class="text-xl font-bold text-gray-800">Welcome to Sprezz Identity</h3>
                    <p class="text-gray-500">You are logged into the administration console for tenant <span class="font-semibold text-gray-700">{ props.ActiveTenant.Name }</span>.</p>
                </div>
            }
        </div>
    }
}

type TenantsPageProps struct {
    ActiveTenant  model.Tenant
    IsAdminTenant bool
    Tenants       []model.Tenant
    Errors        map[string]string
    Msg           string
}

templ TenantsContent(props TenantsPageProps) {
    <div class="space-y-6">
        if props.Msg != "" {
            <div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
                { props.Msg }
            </div>
        }

        if props.IsAdminTenant {
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Left: Tenant list -->
                <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
                    <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
                        <h3 class="font-bold text-gray-800">System Tenants</h3>
                        <button
                            hx-get="/admin/tenants/new?modal=true"
                            hx-target="#modal-container"
                            class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm"
                        >
                            + Create Tenant
                        </button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200 text-sm">
                            <thead>
                                <tr class="bg-gray-50 text-gray-500 font-semibold border-b border-gray-200">
                                    <th class="px-6 py-3 text-left">Name</th>
                                    <th class="px-6 py-3 text-left">Domain</th>
                                    <th class="px-6 py-3 text-left">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                for _, t := range props.Tenants {
                                    <tr class="hover:bg-gray-50 transition">
                                        <td class="px-6 py-4 font-medium text-gray-900">{ t.Name }</td>
                                        <td class="px-6 py-4 text-gray-500">{ t.Domain }</td>
                                        <td class="px-6 py-4">
                                            @StatusBadge(t.IsActive)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Right: Admin Tenant Settings -->
                <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden p-6 space-y-4">
                    <h3 class="font-bold text-gray-800 border-b border-gray-200 pb-3">Administrative Tenant Settings</h3>
                    <form hx-post="/admin/tenants/settings" hx-indicator="#global-spinner" class="space-y-4">
                        @InputField("Tenant Name", "name", "text", props.ActiveTenant.Name, props.Errors["name"])
                        @InputField("Canonical Domain", "domain", "text", props.ActiveTenant.Domain, props.Errors["domain"])
                        @URIInputField("Default Redirect URI", "default_redirect_uri", props.ActiveTenant.Config.DefaultRedirectURI, props.Errors["default_redirect_uri"])
                        @URLManager("Redirect Whitelist", "redirect_whitelist", props.ActiveTenant.Config.RedirectWhitelist, props.Errors["redirect_whitelist"])

                        <!-- Tenant Predefined Scopes & Audiences visual configs -->
                        <div class="border-t border-gray-200 pt-4 mt-4">
                            <h4 class="text-sm font-semibold text-slate-800 mb-3 font-medium">Tenant Scopes & Audiences</h4>

                            <div x-data="scopesManager" data-input-name="predefined_scopes" data-initial-scopes={ marshalURLs(props.ActiveTenant.Config.PredefinedScopes) } class="mb-4">
                                <label class="block text-sm font-medium text-slate-700 mb-1.5">Predefined Scopes</label>

                                <template x-for="tag in customTags" :key="tag">
                                    <input type="hidden" name="predefined_scopes" :value="tag" />
                                </template>

                                <div class="grid grid-cols-2 gap-2 mb-3 bg-slate-50 p-3 rounded-lg border border-slate-200">
                                    <template x-for="s in builtIn" :key="s">
                                        <label class="flex items-center space-x-2 text-sm font-medium text-slate-700 cursor-pointer select-none">
                                            <input
                                                type="checkbox"
                                                name="predefined_scopes"
                                                :value="s"
                                                x-model="selectedBuiltIn"
                                                class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                                            />
                                            <span x-text="s" class="font-mono text-xs"></span>
                                        </label>
                                    </template>
                                </div>

                                <div class="flex flex-wrap gap-1.5 mb-2" x-show="customTags.length > 0">
                                    <template x-for="(tag, index) in customTags" :key="tag">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-blue-100 text-blue-800 border border-blue-200 font-mono">
                                            <span x-text="tag"></span>
                                            <button
                                                type="button"
                                                @click="removeTag(index)"
                                                class="ml-1.5 text-blue-500 hover:text-blue-700 font-bold focus:outline-none"
                                            >
                                                ✕
                                            </button>
                                        </span>
                                    </template>
                                </div>

                                <div class="flex space-x-2">
                                    <input
                                        type="text"
                                        x-model="newTag"
                                        @keydown.enter.prevent="addTag()"
                                        placeholder="Custom scope (e.g. read:orders)"
                                        class="flex-1 px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                                    />
                                    <button
                                        type="button"
                                        @click="addTag()"
                                        class="px-4 py-2 bg-slate-800 text-white rounded-lg text-sm font-semibold hover:bg-slate-700 transition"
                                    >
                                        Add Scope
                                    </button>
                                </div>
                                <div x-show="error" class="text-xs text-red-500 mt-1" x-text="error" style="display: none;"></div>
                            </div>

                            <div x-data="audiencesManager" data-input-name="predefined_audiences" data-initial-audiences={ marshalURLs(props.ActiveTenant.Config.PredefinedAudiences) } class="mb-4">
                                <label class="block text-sm font-medium text-slate-700 mb-1">Predefined Token Audiences</label>

                                <template x-for="aud in audiences" :key="aud">
                                    <input type="hidden" name="predefined_audiences" :value="aud" />
                                </template>

                                <div class="flex flex-wrap gap-1.5 mb-2" x-show="audiences.length > 0">
                                    <template x-for="(aud, index) in audiences" :key="aud">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-purple-100 text-purple-800 border border-purple-200 font-mono">
                                            <span x-text="aud"></span>
                                            <button
                                                type="button"
                                                @click="removeAudience(index)"
                                                class="ml-1.5 text-purple-500 hover:text-purple-700 font-bold focus:outline-none"
                                            >
                                                ✕
                                            </button>
                                        </span>
                                    </template>
                                </div>

                                <div class="flex space-x-2">
                                    <input
                                        type="text"
                                        x-model="newAudience"
                                        @keydown.enter.prevent="addAudience()"
                                        placeholder="Audience identifier (e.g. https://api.example.com)"
                                        class="flex-1 px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                                    />
                                    <button
                                        type="button"
                                        @click="addAudience()"
                                        class="px-4 py-2 bg-slate-800 text-white rounded-lg text-sm font-semibold hover:bg-slate-700 transition"
                                    >
                                        Add Audience
                                    </button>
                                </div>
                                <div x-show="error" class="text-xs text-red-500 mt-1" x-text="error" style="display: none;"></div>
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                            <div>
                                <p class="text-sm font-semibold text-gray-800">Public Registration State</p>
                                <p class="text-xs text-gray-500">Allow self-registration for global administrators.</p>
                            </div>
                            <button
                                type="button"
                                hx-patch={ fmt.Sprintf("/admin/tenants/%s/toggle-signup", props.ActiveTenant.ID.String()) }
                                class={ "px-3 py-1.5 rounded-lg text-sm font-semibold transition", templ.KV("bg-red-600 text-white hover:bg-red-700", props.ActiveTenant.Config.AllowSignup), templ.KV("bg-green-600 text-white hover:bg-green-700", !props.ActiveTenant.Config.AllowSignup) }
                            >
                                if props.ActiveTenant.Config.AllowSignup {
                                    Disable Signup
                                } else {
                                    Enable Signup
                                }
                            </button>
                        </div>

                        <div class="flex justify-end pt-4">
                            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm">
                                Save Settings
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        } else {
            <!-- Normal Tenant Settings Only -->
            <div class="max-w-2xl mx-auto bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden p-6 space-y-4">
                <h3 class="font-bold text-gray-800 border-b border-gray-200 pb-3">Tenant Configuration Settings</h3>
                <form hx-post="/admin/tenants/settings" hx-indicator="#global-spinner" class="space-y-4">
                    @InputField("Tenant Name", "name", "text", props.ActiveTenant.Name, props.Errors["name"])
                    @InputField("Canonical Domain", "domain", "text", props.ActiveTenant.Domain, props.Errors["domain"])
                    @URIInputField("Default Redirect URI", "default_redirect_uri", props.ActiveTenant.Config.DefaultRedirectURI, props.Errors["default_redirect_uri"])
                    @URLManager("Redirect Whitelist", "redirect_whitelist", props.ActiveTenant.Config.RedirectWhitelist, props.Errors["redirect_whitelist"])

                    <!-- Tenant Predefined Scopes & Audiences visual configs -->
                    <div class="border-t border-gray-200 pt-4 mt-4">
                        <h4 class="text-sm font-semibold text-slate-800 mb-3 font-medium">Tenant Scopes & Audiences</h4>

                        <div x-data="scopesManager" data-input-name="predefined_scopes" data-initial-scopes={ marshalURLs(props.ActiveTenant.Config.PredefinedScopes) } class="mb-4">
                            <label class="block text-sm font-medium text-slate-700 mb-1.5">Predefined Scopes</label>

                            <template x-for="tag in customTags" :key="tag">
                                <input type="hidden" name="predefined_scopes" :value="tag" />
                            </template>

                            <div class="grid grid-cols-2 gap-2 mb-3 bg-slate-50 p-3 rounded-lg border border-slate-200">
                                <template x-for="s in builtIn" :key="s">
                                    <label class="flex items-center space-x-2 text-sm font-medium text-slate-700 cursor-pointer select-none">
                                        <input
                                            type="checkbox"
                                            name="predefined_scopes"
                                            :value="s"
                                            x-model="selectedBuiltIn"
                                            class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                                        />
                                        <span x-text="s" class="font-mono text-xs"></span>
                                    </label>
                                </template>
                            </div>

                            <div class="flex flex-wrap gap-1.5 mb-2" x-show="customTags.length > 0">
                                <template x-for="(tag, index) in customTags" :key="tag">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-blue-100 text-blue-800 border border-blue-200 font-mono">
                                        <span x-text="tag"></span>
                                        <button
                                            type="button"
                                            @click="removeTag(index)"
                                            class="ml-1.5 text-blue-500 hover:text-blue-700 font-bold focus:outline-none"
                                        >
                                            ✕
                                        </button>
                                    </span>
                                </template>
                            </div>

                            <div class="flex space-x-2">
                                <input
                                    type="text"
                                    x-model="newTag"
                                    @keydown.enter.prevent="addTag()"
                                    placeholder="Custom scope (e.g. read:orders)"
                                    class="flex-1 px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                                />
                                <button
                                    type="button"
                                    @click="addTag()"
                                    class="px-4 py-2 bg-slate-800 text-white rounded-lg text-sm font-semibold hover:bg-slate-700 transition"
                                >
                                    Add Scope
                                </button>
                            </div>
                            <div x-show="error" class="text-xs text-red-500 mt-1" x-text="error" style="display: none;"></div>
                        </div>

                        <div x-data="audiencesManager" data-input-name="predefined_audiences" data-initial-audiences={ marshalURLs(props.ActiveTenant.Config.PredefinedAudiences) } class="mb-4">
                            <label class="block text-sm font-medium text-slate-700 mb-1">Predefined Token Audiences</label>

                            <template x-for="aud in audiences" :key="aud">
                                <input type="hidden" name="predefined_audiences" :value="aud" />
                            </template>

                            <div class="flex flex-wrap gap-1.5 mb-2" x-show="audiences.length > 0">
                                <template x-for="(aud, index) in audiences" :key="aud">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-purple-100 text-purple-800 border border-purple-200 font-mono">
                                        <span x-text="aud"></span>
                                        <button
                                            type="button"
                                            @click="removeAudience(index)"
                                            class="ml-1.5 text-purple-500 hover:text-purple-700 font-bold focus:outline-none"
                                        >
                                            ✕
                                        </button>
                                    </span>
                                </template>
                            </div>

                            <div class="flex space-x-2">
                                <input
                                    type="text"
                                    x-model="newAudience"
                                    @keydown.enter.prevent="addAudience()"
                                    placeholder="Audience identifier (e.g. https://api.example.com)"
                                    class="flex-1 px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                                />
                                <button
                                    type="button"
                                    @click="addAudience()"
                                    class="px-4 py-2 bg-slate-800 text-white rounded-lg text-sm font-semibold hover:bg-slate-700 transition"
                                >
                                    Add Audience
                                </button>
                            </div>
                            <div x-show="error" class="text-xs text-red-500 mt-1" x-text="error" style="display: none;"></div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                        <div>
                            <p class="text-sm font-semibold text-gray-800">Public Registration State</p>
                            <p class="text-xs text-gray-500">Allow self-registration for users in this tenant partition.</p>
                        </div>
                        <button
                            type="button"
                            hx-patch={ fmt.Sprintf("/admin/tenants/%s/toggle-signup", props.ActiveTenant.ID.String()) }
                            class={ "px-3 py-1.5 rounded-lg text-sm font-semibold transition", templ.KV("bg-red-600 text-white hover:bg-red-700", props.ActiveTenant.Config.AllowSignup), templ.KV("bg-green-600 text-white hover:bg-green-700", !props.ActiveTenant.Config.AllowSignup) }
                        >
                            if props.ActiveTenant.Config.AllowSignup {
                                Disable Signup
                            } else {
                                Enable Signup
                            }
                        </button>
                    </div>

                    <div class="flex justify-end pt-4">
                        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm">
                            Save Configuration
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>
}

templ TenantsPage(props TenantsPageProps) {
    @AdminLayout(AdminLayoutProps{Title: "Tenants", CurrentTab: "tenants", TenantName: props.ActiveTenant.Name}) {
        @TenantsContent(props)
    }
}

templ CreateTenantForm(errors map[string]string) {
    <form hx-post="/admin/tenants" hx-target="#modal-body" class="space-y-4">
        @InputField("Tenant Name", "name", "text", "", errors["name"])
        @InputField("Canonical Domain", "domain", "text", "", errors["domain"])
        <div class="flex justify-end space-x-3 pt-4 border-t border-slate-200">
            <button
                type="button"
                class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition"
                @click="isOpen = false"
            >
                Cancel
            </button>
            <button
                type="submit"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition"
            >
                Create Tenant
            </button>
        </div>
    </form>
}

type ClientsPageProps struct {
    ActiveTenant model.Tenant
    Clients      []model.ClientApplication
    Msg          string
}

templ ClientsContent(props ClientsPageProps) {
    <div class="space-y-6">
        if props.Msg != "" {
            <div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
                { props.Msg }
            </div>
        }

        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
                <h3 class="font-bold text-gray-800">OIDC Applications</h3>
                <button
                    hx-get="/admin/clients/new?modal=true"
                    hx-target="#modal-container"
                    class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm"
                >
                    + New Application
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                    <thead>
                        <tr class="bg-gray-50 text-gray-500 font-semibold border-b border-gray-200">
                            <th class="px-6 py-3 text-left">Client ID</th>
                            <th class="px-6 py-3 text-left">Application Name</th>
                            <th class="px-6 py-3 text-left">Type</th>
                            <th class="px-6 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        for _, c := range props.Clients {
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-4 font-mono font-medium text-gray-900">{ c.ClientID }</td>
                                <td class="px-6 py-4 text-gray-500">{ c.ClientName }</td>
                                <td class="px-6 py-4 text-gray-500 capitalize">{ string(c.ClientType) }</td>
                                <td class="px-6 py-4 text-right space-x-2">
                                    <button
                                        hx-get={ fmt.Sprintf("/admin/clients/view?id=%s&modal=true", c.ClientID) }
                                        hx-target="#modal-container"
                                        class="text-blue-600 hover:text-blue-800 font-medium"
                                    >
                                        View
                                    </button>
                                    <button
                                        hx-get={ fmt.Sprintf("/admin/clients/edit?id=%s&modal=true", c.ClientID) }
                                        hx-target="#modal-container"
                                        class="text-green-600 hover:text-green-800 font-medium"
                                    >
                                        Edit
                                    </button>
                                    <button
                                        hx-delete={ fmt.Sprintf("/admin/clients/%s", c.ClientID) }
                                        hx-confirm={ fmt.Sprintf("Are you sure you want to delete application '%s'?", c.ClientName) }
                                        hx-target="body"
                                        class="text-red-600 hover:text-red-800 font-medium"
                                    >
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

templ ClientsPage(props ClientsPageProps) {
    @AdminLayout(AdminLayoutProps{Title: "Applications", CurrentTab: "clients", TenantName: props.ActiveTenant.Name}) {
        @ClientsContent(props)
    }
}

type ClientFormProps struct {
    Client    model.ClientApplication
    Errors    map[string]string
    IsEdit    bool
    ReadOnly  bool
    Providers []model.IdentityProvider
}

templ ClientForm(props ClientFormProps) {
    <form
        hx-post="/admin/clients"
        hx-target="#modal-body"
        class="space-y-6"
        x-data={ fmt.Sprintf("clientFormManager('%s', %t, %t, %d)", getInitialClientType(props.Client.ClientType), hasGrantType(props.Client.GrantTypes, "authorization_code", true), hasGrantType(props.Client.GrantTypes, "client_credentials", false), len(props.Client.AllowedIDPs)) }
        @idp-count-update.window="handleIdpChange($event.detail.count)"
    >
        @ClientIdentitySection(props)
        @ClientGrantTypesSection()
        @ClientSecuritySection(props)
        @ClientUrisSection(props)
        @ClientLifetimesSection(props)
        @ClientIdpRoutingSection(props)

        <div class="flex justify-end space-x-3 pt-4 border-t border-slate-200">
            <button
                type="button"
                class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition cursor-pointer"
                @click="isOpen = false"
            >
                Close
            </button>
            if !props.ReadOnly {
                <button
                    type="submit"
                    :disabled="isSubmitDisabled"
                    class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold transition cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                >
                    if props.IsEdit {
                        Save Changes
                    } else {
                        Create Application
                    }
                </button>
            }
        </div>
    </form>
}

type IDPsPageProps struct {
    ActiveTenant model.Tenant
    Providers    []model.IdentityProvider
    Msg          string
}

templ IDPsContent(props IDPsPageProps) {
    <div class="space-y-6">
        if props.Msg != "" {
            <div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
                { props.Msg }
            </div>
        }

        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
                <h3 class="font-bold text-gray-800">Identity Providers</h3>
                <button
                    hx-get="/admin/idps/new?modal=true"
                    hx-target="#modal-container"
                    class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition shadow-sm"
                >
                    + Add Provider
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                    <thead>
                        <tr class="bg-gray-50 text-gray-500 font-semibold border-b border-gray-200">
                            <th class="px-6 py-3 text-left">Alias</th>
                            <th class="px-6 py-3 text-left">Type</th>
                            <th class="px-6 py-3 text-left">Status</th>
                            <th class="px-6 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        for _, p := range props.Providers {
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-4 font-medium text-gray-900">{ p.Alias }</td>
                                <td class="px-6 py-4 text-gray-500 capitalize">{ p.IDPType }</td>
                                <td class="px-6 py-4">
                                    @IDPStatusBadge(p.Enabled)
                                </td>
                                <td class="px-6 py-4 text-right space-x-2">
                                    <button
                                        hx-get={ fmt.Sprintf("/admin/idps/edit?id=%s&modal=true", p.ID.String()) }
                                        hx-target="#modal-container"
                                        class="text-green-600 hover:text-green-800 font-medium"
                                    >
                                        Edit
                                    </button>
                                    <button
                                        hx-delete={ fmt.Sprintf("/admin/idps/%s", p.ID.String()) }
                                        hx-confirm={ fmt.Sprintf("Are you sure you want to delete identity provider '%s'?", p.Alias) }
                                        hx-target="body"
                                        class="text-red-600 hover:text-red-800 font-medium"
                                    >
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

templ IDPsPage(props IDPsPageProps) {
    @AdminLayout(AdminLayoutProps{Title: "Identity Providers", CurrentTab: "idps", TenantName: props.ActiveTenant.Name}) {
        @IDPsContent(props)
    }
}

type IDPFormProps struct {
    Provider model.IdentityProvider
    Errors   map[string]string
    IsEdit   bool
}

templ IDPForm(props IDPFormProps) {
    <form hx-post="/admin/idps" hx-target="#modal-body" class="space-y-4">
        if props.IsEdit {
            <input type="hidden" name="id" value={ props.Provider.ID.String() }/>
            <input type="hidden" name="idp_type" value={ props.Provider.IDPType }/>
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-500 mb-1">Provider Type</label>
                <div class="font-semibold text-gray-800 bg-gray-50 px-3 py-2 border border-slate-300 rounded-lg capitalize">{ props.Provider.IDPType }</div>
            </div>
        } else {
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-1">Provider Type</label>
                <select name="idp_type" class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    <option value="username-password">Username Password</option>
                    <option value="oidc">OpenID Connect</option>
                    <option value="saml">SAML 2.0</option>
                </select>
            </div>
        }

        @InputField("Alias", "alias", "text", props.Provider.Alias, props.Errors["alias"])

        <div class="flex items-center space-x-3 mb-4">
            <input
                type="checkbox"
                id="enabled"
                name="enabled"
                value="true"
                checked?={ props.Provider.Enabled }
                class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
            />
            <label for="enabled" class="text-sm font-medium text-slate-700">Enabled</label>
        </div>

        <div class="mb-4">
            <label class="block text-sm font-medium text-slate-700 mb-1">Username Field Mapping</label>
            <select name="username_field" class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <option value="preferredUsername" selected?={ props.Provider.Config.UsernameField == "preferredUsername" }>Username (preferredUsername)</option>
                <option value="email" selected?={ props.Provider.Config.UsernameField == "email" }>Email</option>
            </select>
        </div>

        <div class="mb-4">
            <label class="block text-sm font-medium text-slate-700 mb-1">Identity Assurance Level (IAL)</label>
            <select name="ial" class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <option value="0" selected?={ props.Provider.Config.IAL == 0 }>IAL 0</option>
                <option value="1" selected?={ props.Provider.Config.IAL == 1 }>IAL 1</option>
                <option value="2" selected?={ props.Provider.Config.IAL == 2 }>IAL 2</option>
                <option value="3" selected?={ props.Provider.Config.IAL == 3 }>IAL 3</option>
            </select>
        </div>

        <div class="mb-4">
            <label class="block text-sm font-medium text-slate-700 mb-1">Authenticator Assurance Level (AAL)</label>
            <select name="aal" class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <option value="0" selected?={ props.Provider.Config.AAL == 0 }>AAL 0</option>
                <option value="1" selected?={ props.Provider.Config.AAL == 1 }>AAL 1</option>
                <option value="2" selected?={ props.Provider.Config.AAL == 2 }>AAL 2</option>
                <option value="3" selected?={ props.Provider.Config.AAL == 3 }>AAL 3</option>
            </select>
        </div>

        <div class="flex justify-end space-x-3 pt-4 border-t border-slate-200">
            <button
                type="button"
                class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition"
                @click="isOpen = false"
            >
                Cancel
            </button>
            <button
                type="submit"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition"
            >
                if props.IsEdit {
                    Save Changes
                } else {
                    Create Provider
                }
            </button>
        </div>
    </form>
}

type UsersPageProps struct {
    ActiveTenant model.Tenant
    Users        []model.UserProfile
    Msg          string
}

templ UsersContent(props UsersPageProps) {
    <div class="space-y-6">
        if props.Msg != "" {
            <div class="p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium">
                { props.Msg }
            </div>
        }

        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
                <h3 class="font-bold text-gray-800">User Profiles</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                    <thead>
                        <tr class="bg-gray-50 text-gray-500 font-semibold border-b border-gray-200">
                            <th class="px-6 py-3 text-left">Username</th>
                            <th class="px-6 py-3 text-left">Name</th>
                            <th class="px-6 py-3 text-left">Email</th>
                            <th class="px-6 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        for _, u := range props.Users {
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-4 font-mono font-medium text-gray-900">{ u.PreferredUsername }</td>
                                <td class="px-6 py-4 text-gray-500">{ u.Name }</td>
                                <td class="px-6 py-4 text-gray-500">{ u.Email }</td>
                                <td class="px-6 py-4 text-right space-x-2">
                                    <button
                                        hx-get={ fmt.Sprintf("/admin/users/view?id=%s&modal=true", u.ID.String()) }
                                        hx-target="#modal-container"
                                        class="text-blue-600 hover:text-blue-800 font-medium"
                                    >
                                        View
                                    </button>
                                    <button
                                        hx-get={ fmt.Sprintf("/admin/users/edit?id=%s&modal=true", u.ID.String()) }
                                        hx-target="#modal-container"
                                        class="text-green-600 hover:text-green-800 font-medium"
                                    >
                                        Edit
                                    </button>
                                    <button
                                        hx-delete={ fmt.Sprintf("/admin/users/%s", u.ID.String()) }
                                        hx-confirm={ fmt.Sprintf("Are you sure you want to delete user '%s'?", u.PreferredUsername) }
                                        hx-target="body"
                                        class="text-red-600 hover:text-red-800 font-medium"
                                    >
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

templ UsersPage(props UsersPageProps) {
    @AdminLayout(AdminLayoutProps{Title: "Users", CurrentTab: "users", TenantName: props.ActiveTenant.Name}) {
        @UsersContent(props)
    }
}

type UserFormProps struct {
    User   model.UserProfile
    Errors map[string]string
}

templ UserForm(props UserFormProps) {
    <form hx-post="/admin/users" hx-target="#modal-body" class="space-y-4">
        <input type="hidden" name="id" value={ props.User.ID.String() }/>

        @InputField("Username", "preferred_username", "text", props.User.PreferredUsername, props.Errors["preferred_username"])
        @InputField("Full Name", "name", "text", props.User.Name, props.Errors["name"])
        @InputField("Email", "email", "email", props.User.Email, props.Errors["email"])

        <div class="flex items-center space-x-3 mb-4">
            <input
                type="checkbox"
                id="email_verified"
                name="email_verified"
                value="true"
                checked?={ props.User.EmailVerified }
                class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
            />
            <label for="email_verified" class="text-sm font-medium text-slate-700">Email Verified</label>
        </div>

        <div class="flex justify-end space-x-3 pt-4 border-t border-slate-200">
            <button
                type="button"
                class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition"
                @click="isOpen = false"
            >
                Cancel
            </button>
            <button
                type="submit"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-semibold hover:bg-blue-700 transition"
            >
                Save Changes
            </button>
        </div>
    </form>
}

type UserDetailsProps struct {
    User       model.UserProfile
    Identities []model.UserIdentity
    Providers  []model.IdentityProvider
}

templ UserDetails(props UserDetailsProps) {
    <div class="space-y-6">
        <!-- Profile info summary -->
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-100 grid grid-cols-2 gap-4 text-sm">
            <div>
                <p class="text-xs text-slate-500 font-semibold uppercase">Preferred Username</p>
                <p class="font-mono text-gray-800 font-medium">{ props.User.PreferredUsername }</p>
            </div>
            <div>
                <p class="text-xs text-slate-500 font-semibold uppercase">Full Name</p>
                <p class="text-gray-800 font-medium">{ props.User.Name }</p>
            </div>
            <div>
                <p class="text-xs text-slate-500 font-semibold uppercase">Email</p>
                <p class="text-gray-800 font-medium">{ props.User.Email }</p>
            </div>
            <div>
                <p class="text-xs text-slate-500 font-semibold uppercase">Email Verified</p>
                @VerifiedBadge(props.User.EmailVerified)
            </div>
        </div>

        <!-- Coupled identities section -->
        <div class="space-y-3">
            <h4 class="font-bold text-gray-800 text-sm border-b border-gray-200 pb-2">Coupled Identities</h4>
            if len(props.Identities) == 0 {
                <p class="text-sm text-gray-500">No identities coupled to this profile yet.</p>
            } else {
                <div class="space-y-3">
                    for _, ident := range props.Identities {
                        <div class="flex items-center justify-between p-3 border border-gray-200 rounded-lg text-sm">
                            <div>
                                <p class="font-semibold text-gray-800">
                                    for _, p := range props.Providers {
                                        if p.ID == ident.IdentityProviderID {
                                            { p.Alias } <span class="text-xs text-gray-400 capitalize">({ p.IDPType })</span>
                                        }
                                    }
                                </p>
                                <p class="font-mono text-xs text-gray-500 mt-1">External Sub/ID: { ident.ExternalIdentityID }</p>
                                <p class="text-xs text-gray-500">Login Count: { fmt.Sprintf("%d", ident.LoginCount) } | Blocked: { fmt.Sprintf("%t", ident.Blocked) }</p>
                                <p class="text-xs text-gray-400 mt-0.5">Coupled at: { ident.CoupledAt.Format("2006-01-02 15:04:05") }</p>
                            </div>
                            <button
                                hx-delete={ fmt.Sprintf("/admin/users/%s/identities/%s", props.User.ID.String(), ident.IdentityProviderID.String()) }
                                hx-confirm="Are you sure you want to decouple this identity from the user's profile?"
                                hx-target="#modal-body"
                                class="px-2.5 py-1.5 bg-red-50 text-red-600 hover:bg-red-100 rounded-lg text-xs font-semibold transition"
                            >
                                Decouple
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="flex justify-end pt-4 border-t border-slate-200">
            <button
                type="button"
                class="px-4 py-2 border border-slate-300 rounded-lg text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition"
                @click="isOpen = false"
            >
                Close
            </button>
        </div>
    </div>
}

templ ClientIdentitySection(props ClientFormProps) {
    <div class="bg-white p-6 border border-gray-200 rounded-xl shadow-sm space-y-4">
        <h3 class="text-base font-semibold text-gray-900">Application Identity</h3>

        @InputField("Application Name", "client_name", "text", props.Client.ClientName, props.Errors["client_name"])

        if props.IsEdit {
            <input type="hidden" name="id" value={ props.Client.ID }/>
            <input type="hidden" name="client_id" value={ props.Client.ClientID }/>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Client ID</label>
                <div class="font-mono text-gray-800 bg-gray-50 px-3 py-2 border border-slate-300 rounded-lg select-all">{ props.Client.ClientID }</div>
            </div>
        } else {
            <div x-data="idSecretGenerator('')">
                <label class="block text-sm font-medium text-slate-700 mb-1">Client ID</label>
                <div class="flex space-x-2">
                    <input
                        type="text"
                        name="client_id"
                        x-model="value"
                        placeholder="Enter custom Client ID or generate one"
                        pattern="^[a-zA-Z0-9\-_\.~]+$"
                        title="Only RFC 3986 unreserved characters allowed (A-Z, a-z, 0-9, -, _, ., ~)"
                        class="flex-1 px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm font-mono"
                        required
                    />
                    <button
                        type="button"
                        @click="generate()"
                        class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-sm font-semibold transition cursor-pointer"
                    >
                        Generate ID
                    </button>
                </div>
                <p class="text-xs text-slate-500 mt-1">Unique identifier. Restricted to unreserved characters (RFC 3986 Section 2.3).</p>
            </div>
        }

        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Client Type</label>
            <select name="client_type" x-model="clientType" @change="handleClientType($el.value)" class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                <option value="confidential">Confidential (Web Apps / Servers)</option>
                <option value="public">Public (Native / Single Page Apps)</option>
            </select>
        </div>

        <!-- Client Secret (Only visible for Confidential) -->
        <div x-show="clientType === 'confidential'" x-transition class="pt-2">
            if props.IsEdit {
                <label class="block text-sm font-medium text-slate-700 mb-1">Client Secret</label>
                <div id="client-secret-container" class="flex items-center space-x-2">
                    <div class="font-mono text-gray-400 bg-gray-50 px-3 py-2 border border-slate-300 rounded-lg flex-1">••••••••••••••••</div>
                    if !props.ReadOnly {
                        <button type="button" hx-post={ fmt.Sprintf("/admin/clients/%s/reset-secret", props.Client.ClientID) } hx-target="#client-secret-container" hx-confirm="Are you sure you want to reset the Client Secret?" class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-lg text-sm font-semibold transition cursor-pointer">Reset Secret</button>
                    }
                </div>
            } else {
                <div x-data="idSecretGenerator('')">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Initial Client Secret</label>
                    <div class="flex space-x-2">
                        <div class="relative flex-1">
                            <input
                                :type="showSecret ? 'text' : 'password'"
                                name="client_secret"
                                x-model="value"
                                placeholder="Enter custom secret or generate one"
                                pattern="^[a-zA-Z0-9\-_\.~]+$"
                                title="Only RFC 3986 unreserved characters allowed (A-Z, a-z, 0-9, -, _, ., ~)"
                                class="w-full px-3 py-2 border border-slate-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm font-mono"
                            />
                            <button
                                type="button"
                                @click="toggleShow()"
                                class="absolute right-2 top-2 text-gray-400 hover:text-gray-600 focus:outline-none"
                            >
                                <span x-text="showSecret ? '🙈' : '👁️'"></span>
                            </button>
                        </div>
                        <button
                            type="button"
                            @click="generate()"
                            class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-sm font-semibold transition cursor-pointer"
                        >
                            Generate
                        </button>
                    </div>
                    <p class="text-xs text-slate-500 mt-1">Restricted to unreserved characters (RFC 3986 Section 2.3).</p>
                </div>
            }
        </div>
    </div>
}

templ ClientGrantTypesSection() {
    <div class="bg-white p-6 border border-gray-200 rounded-xl shadow-sm space-y-4">
        <h3 class="text-base font-semibold text-gray-900">Allowed Grant Types</h3>
        <div class="flex flex-col space-y-2">
            <label class="flex items-center space-x-2 text-sm text-gray-700 cursor-pointer select-none">
                <input
                    type="checkbox"
                    name="grant_types"
                    value="authorization_code"
                    :checked="authCode"
                    :disabled="clientType === 'public'"
                    @change="handleAuthCodeChange($el.checked)"
                    class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                />
                <span>Authorization Code Flow (Requires User Login)</span>
            </label>
            <label x-show="clientType === 'confidential'" x-transition class="flex items-center space-x-2 text-sm text-gray-700 cursor-pointer select-none">
                <input
                    type="checkbox"
                    name="grant_types"
                    value="client_credentials"
                    :checked="clientCredentials"
                    @change="handleClientCredentialsChange($el.checked)"
                    class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                />
                <span>Client Credentials Flow (Machine-to-Machine / No User)</span>
            </label>
        </div>
    </div>
}

templ ClientSecuritySection(props ClientFormProps) {
    <div class="bg-white p-6 border border-gray-200 rounded-xl shadow-sm space-y-6">
        <!-- 3. Scopes Configuration -->
        <div x-data="scopesManager" data-input-name="scopes" data-initial-scopes={ marshalURLs(props.Client.AllowedScopes) } class="mb-4">
            <label class="block text-sm font-medium text-slate-700 mb-2">OAuth Scopes</label>
            <template x-for="tag in customTags"><input type="hidden" name="scopes" :value="tag"/></template>
            <div class="grid grid-cols-2 gap-2 mb-3 bg-slate-50 p-3 rounded-lg border border-slate-200">
                <template x-for="s in builtIn">
                    <label class="flex items-center space-x-2 text-sm font-medium text-slate-700 cursor-pointer select-none">
                        <input type="checkbox" name="scopes" :value="s" x-model="selectedBuiltIn" class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"/>
                        <span x-text="s" class="font-mono text-xs"></span>
                    </label>
                </template>
            </div>
            <div class="flex flex-wrap gap-1.5 mb-2">
                <template x-for="(tag, index) in customTags" :key="tag">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-blue-100 text-blue-800 font-mono">
                        <span x-text="tag"></span>
                        <button type="button" @click="removeTag(index)" class="ml-1.5 text-blue-500 hover:text-blue-700">✕</button>
                    </span>
                </template>
            </div>
            <div class="flex space-x-2">
                <input type="text" x-model="newTag" @keydown.enter.prevent="addTag()" placeholder="e.g. read:orders" class="flex-1 px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                <button type="button" @click="addTag()" class="px-4 py-2 bg-slate-800 text-white rounded-lg text-sm font-semibold hover:bg-slate-700 cursor-pointer">Add</button>
            </div>
        </div>

        <!-- Token Audiences (aud) -->
        <div x-data="audiencesManager" data-input-name="audiences" data-initial-audiences={ marshalURLs(props.Client.AllowedAudiences) } class="mb-4 pt-4 border-t border-gray-100">
            <label class="block text-sm font-medium text-slate-700 mb-2">Token Audiences (aud)</label>
            <template x-for="aud in audiences"><input type="hidden" name="audiences" :value="aud"/></template>
            <div class="flex flex-wrap gap-1.5 mb-2">
                <template x-for="(aud, index) in audiences" :key="aud">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-purple-100 text-purple-800 font-mono">
                        <span x-text="aud"></span>
                        <button type="button" @click="removeAudience(index)" class="ml-1.5 text-purple-500 hover:text-purple-700">✕</button>
                    </span>
                </template>
            </div>
            <div class="flex space-x-2">
                <input type="text" x-model="newAudience" @keydown.enter.prevent="addAudience()" placeholder="e.g. https://example.com" class="flex-1 px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                <button type="button" @click="addAudience()" class="px-4 py-2 bg-slate-800 text-white rounded-lg text-sm font-semibold hover:bg-slate-700 cursor-pointer">Add</button>
            </div>
        </div>
    </div>
}

templ ClientUrisSection(props ClientFormProps) {
    <!-- 4. Authorized URIs Matrix -->
    <div x-show="clientType === 'public' || authCode" x-transition class="bg-white p-6 border border-gray-200 rounded-xl shadow-sm space-y-4">
        <h3 class="text-base font-semibold text-gray-900">Redirect & Logout URIs</h3>
        @URIInputField("Default Redirect URI", "redirect_uri", props.Client.RedirectURI, props.Errors["redirect_uri"])
        @URLManager("Additional Redirect URIs", "redirect_uris", props.Client.RedirectURIs, props.Errors["redirect_uris"])
        @URLManager("Post-Logout Redirect URIs", "post_logout_redirect_uris", props.Client.PostLogoutRedirectURIs, props.Errors["post_logout_redirect_uris"])
        @URIInputField("Front-Channel Logout URI", "front_channel_logout_uri", props.Client.FrontChannelLogoutURI, props.Errors["front_channel_logout_uri"])
        @URIInputField("Back-Channel Logout URI", "back_channel_logout_uri", props.Client.BackChannelLogoutURI, props.Errors["back_channel_logout_uri"])
    </div>
}

templ ClientLifetimesSection(props ClientFormProps) {
    <!-- 5. Token Lifetimes Policy -->
    <div class="bg-white p-6 border border-gray-200 rounded-xl shadow-sm space-y-4">
        <h3 class="text-base font-semibold text-gray-900">Token Lifetimes</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div x-data={ fmt.Sprintf("lifetimeCalculator(%d)", int64(props.Client.AccessTokenLifetime / time.Second)) }>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Access Token</label>
                <input type="hidden" name="access_token_lifetime" :value="seconds" />
                <div class="flex space-x-2">
                    <input type="number" min="1" x-model="value" @input="updateSeconds()" class="w-24 px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                    <select x-model="unit" @change="updateSeconds()" class="w-20 px-2 py-2 border border-slate-300 rounded-lg text-sm bg-gray-50"><option value="minutes">Min</option><option value="hours">Hrs</option><option value="days">Days</option></select>
                </div>
            </div>
            <div x-data={ fmt.Sprintf("lifetimeCalculator(%d)", int64(props.Client.IDTokenLifetime / time.Second)) }>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">ID Token</label>
                <input type="hidden" name="id_token_lifetime" :value="seconds" />
                <div class="flex space-x-2">
                    <input type="number" min="1" x-model="value" @input="updateSeconds()" class="w-24 px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                    <select x-model="unit" @change="updateSeconds()" class="w-20 px-2 py-2 border border-slate-300 rounded-lg text-sm bg-gray-50"><option value="minutes">Min</option><option value="hours">Hrs</option><option value="days">Days</option></select>
                </div>
            </div>
            <div x-data={ fmt.Sprintf("lifetimeCalculator(%d)", int64(props.Client.RefreshTokenLifetime / time.Second)) } @client-type-public.window="snapToPublicDefault()">
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Refresh Token</label>
                <input type="hidden" name="refresh_token_lifetime" :value="seconds" />
                <div class="flex space-x-2">
                    <input type="number" min="1" x-model="value" @input="updateSeconds()" class="w-24 px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"/>
                    <select x-model="unit" @change="updateSeconds()" class="w-20 px-2 py-2 border border-slate-300 rounded-lg text-sm bg-gray-50"><option value="minutes">Min</option><option value="hours">Hrs</option><option value="days">Days</option></select>
                </div>
            </div>
        </div>
    </div>
}

func initIdpRoutingData(props ClientFormProps) string {
    allowedBytes, _ := json.Marshal(props.Client.AllowedIDPs)
    if len(props.Client.AllowedIDPs) == 0 {
        allowedBytes = []byte("[]")
    }

    type IDPInfo struct {
        ID    string `json:"id"`
        Alias string `json:"alias"`
    }
    availablePool := []IDPInfo{}
    for _, p := range props.Providers {
        if p.IDPType != "username-password" {
            availablePool = append(availablePool, IDPInfo{ID: p.ID.String(), Alias: p.Alias})
        }
    }
    availableBytes, _ := json.Marshal(availablePool)

    return fmt.Sprintf("idpRouter(%s, %s, '%s')", string(allowedBytes), string(availableBytes), props.Client.DefaultIDP)
}

templ ClientIdpRoutingSection(props ClientFormProps) {
    <div
        class="bg-white p-6 border border-gray-200 rounded-xl shadow-sm space-y-6 animate-fade-in"
        x-show="authCode"
        x-data={ initIdpRoutingData(props) }
    >
        <div>
            <h3 class="text-base font-semibold text-gray-900">Identity Providers Routing</h3>
            <p class="text-xs text-gray-400 mt-1">Select which identity connections are allowed for this client application.</p>
        </div>

        <!-- Checkbox Grid Matrix -->
        <div class="space-y-3">
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide text-gray-400">Allowed Providers</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

                <!-- Static Card: Local Accounts -->
                <label class="relative flex items-center p-4 rounded-xl border border-gray-200 cursor-pointer bg-white hover:bg-gray-50/50 transition shadow-sm select-none">
                    <input
                        type="checkbox"
                        name="allowed_idps"
                        value="username-password"
                        @change="toggleIdp($el.value)"
                        :checked="allowedIds.includes('username-password')"
                        class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                    />
                    <div class="ml-3 text-sm">
                        <span class="font-medium text-gray-900 block">Local Accounts</span>
                        <span class="text-xs text-gray-400">Built-in credentials database</span>
                    </div>
                </label>

                <!-- Dynamic Upstream External Providers -->
                for _, idp := range props.Providers {
                    if idp.IDPType != "username-password" {
                        <label class="relative flex items-center p-4 rounded-xl border border-gray-200 cursor-pointer bg-white hover:bg-gray-50/50 transition shadow-sm select-none">
                            <input
                                type="checkbox"
                                name="allowed_idps"
                                value={ idp.ID.String() }
                                @change="toggleIdp($el.value)"
                                :checked={ "allowedIds.includes('" + idp.ID.String() + "')" }
                                class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                            />
                            <div class="ml-3 text-sm">
                                <span class="font-medium text-gray-900 block">{ idp.Alias }</span>
                                <span class="text-xs text-gray-400 uppercase font-mono">{ idp.IDPType } Connection</span>
                            </div>
                        </label>
                    }
                }
            </div>
        </div>

        <!-- Dynamic Dropdown Filter -->
        <div class="space-y-2 max-w-md pt-4 border-t border-gray-100">
            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide text-gray-400">Default Login Routing</label>
            <select
                name="default_idp_id"
                x-model="defaultId"
                :disabled="isInvalidState"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 disabled:bg-gray-100 disabled:cursor-not-allowed"
            >
                <option value="">None (Display Core Selection Layout)</option>
                <template x-for="item in allowedList" :key="item.id">
                    <option :value="item.id" x-text="item.name" :selected="item.id === defaultId"></option>
                </template>
            </select>
        </div>

        <!-- Guard Warning -->
        <div x-show="isInvalidState" x-transition class="p-3 bg-red-50 border border-red-200 text-red-700 text-xs rounded-lg font-medium">
            ⚠️ Attention: You must select at least one Identity Provider (or Local Accounts) to save changes.
        </div>
    </div>
}
