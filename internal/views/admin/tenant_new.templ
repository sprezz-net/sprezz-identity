package admin

// NewTenantContent is the add form. Redirects, scopes and registration are set on the tenant's own page.
templ NewTenantContent(props TenantNewProps) {
	@PageHeader("Add tenant", "Tenants", tenantsBase())
	<form hx-post={ tenantsBase() } hx-target="main" hx-swap="innerHTML" hx-indicator="#global-spinner" class="max-w-3xl space-y-6">
		if props.Error != "" {
			<div class="p-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm" role="alert">{ props.Error }</div>
		}
		<section class="bg-white border border-gray-200 rounded-xl shadow-xs">
			<div class="px-6 py-5 space-y-5">
				<div>
					<label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
					<input id="name" type="text" name="name" value={ props.V("name") } required maxlength="100" class={ idpInputClass }/>
					@FieldError(props.Errors["name"])
				</div>
				<div>
					<label for="domain" class="block text-sm font-medium text-gray-700 mb-1">Domain</label>
					<input id="domain" type="text" name="domain" value={ props.V("domain") } required placeholder="id.example.com" class={ idpInputClass + " font-mono" }/>
					@FieldError(props.Errors["domain"])
					<p class="mt-1 text-xs text-gray-500">Only the host name, with an optional port. The tenant answers on this domain, so it must point at this server.</p>
				</div>
			</div>
		</section>
		<button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold transition-colors shadow-xs">Add tenant</button>
	</form>
}

templ NewTenantPage(props TenantNewProps) {
	@AdminLayout(AdminLayoutProps{Title: "Add tenant", CurrentTab: "tenants", TenantName: props.ActiveTenant.Name}) {
		@NewTenantContent(props)
	}
}
