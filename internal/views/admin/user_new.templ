package admin

import "strconv"

// NewUserContent is the add form. Only the essentials are asked for; everything else is set on the user's page.
templ NewUserContent(props UserNewProps) {
	@PageHeader("Add user", "Users", usersBase())
	<form hx-post={ usersBase() } hx-target="main" hx-swap="innerHTML" hx-indicator="#global-spinner" class="max-w-3xl space-y-6">
		if props.Error != "" {
			<div class="p-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm" role="alert">{ props.Error }</div>
		}
		<section class="bg-white border border-gray-200 rounded-xl shadow-xs">
			<div class="px-6 py-5 space-y-5">
				<div>
					<label for="partition_id" class="block text-sm font-medium text-gray-700 mb-1">Partition</label>
					<select id="partition_id" name="partition_id" class={ idpInputClass + " bg-white" }>
						for _, part := range props.Partitions {
							<option value={ strconv.FormatInt(part.ID, 10) } selected?={ props.V("partition_id") == strconv.FormatInt(part.ID, 10) }>{ partitionLabel(part) }</option>
						}
					</select>
					@FieldError(props.Errors["partition_id"])
				</div>
				<div>
					<label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
					<input id="username" type="text" name="username" value={ props.V("username") } required maxlength="64" autocomplete="off" class={ idpInputClass + " font-mono" }/>
					@FieldError(props.Errors["username"])
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					<div>
						<label for="first_name" class="block text-sm font-medium text-gray-700 mb-1">First name</label>
						<input id="first_name" type="text" name="first_name" value={ props.V("first_name") } maxlength="64" class={ idpInputClass }/>
						@FieldError(props.Errors["first_name"])
					</div>
					<div>
						<label for="last_name" class="block text-sm font-medium text-gray-700 mb-1">Last name</label>
						<input id="last_name" type="text" name="last_name" value={ props.V("last_name") } maxlength="64" class={ idpInputClass }/>
						@FieldError(props.Errors["last_name"])
					</div>
				</div>
				<div>
					<label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email address</label>
					<input id="email" type="email" name="email" value={ props.V("email") } required maxlength="255" class={ idpInputClass }/>
					@FieldError(props.Errors["email"])
				</div>
				<div>
					<label for="password" class="block text-sm font-medium text-gray-700 mb-1">Initial password</label>
					<input id="password" type="password" name="password" value="" autocomplete="new-password" minlength="8" maxlength="64" class={ idpInputClass + " font-mono" }/>
					@FieldError(props.Errors["new_password"])
					<p class="mt-1 text-xs text-gray-500">Optional. Without one the account is created but cannot sign in until a password is set.</p>
				</div>
				@ToggleRow("email_verified", "true", "Email address verified", "", props.V("email_verified") == "true", false)
			</div>
		</section>
		<button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold transition-colors shadow-xs">Add user</button>
	</form>
}

templ NewUserPage(props UserNewProps) {
	@AdminLayout(AdminLayoutProps{Title: "Add user", CurrentTab: "users", TenantName: props.ActiveTenant.Name}) {
		@NewUserContent(props)
	}
}
