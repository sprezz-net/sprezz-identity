package admin

import "sprezz-identity/internal/domain/model"

// UserProfileCard edits the identity fields of a user.
templ UserProfileCard(u model.UserProfile, result SectionResult) {
	@SectionCard(SectionCardProps{
		ID:          "section-profile",
		Title:       "Profile",
		Description: "How the user is named and reached.",
		Action:      userSectionAction(u.PartitionID, u.ID.String(), "profile"),
		Saved:       result.Saved,
		Error:       result.Error,
	}) {
		<div>
			<label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
			<input id="username" type="text" name="username" value={ u.PreferredUsername } required maxlength="64" autocomplete="off" class={ idpInputClass + " font-mono" }/>
			@FieldError(result.FieldErr("username"))
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div>
				<label for="first_name" class="block text-sm font-medium text-gray-700 mb-1">First name</label>
				<input id="first_name" type="text" name="first_name" value={ u.FirstName } maxlength="64" class={ idpInputClass }/>
				@FieldError(result.FieldErr("first_name"))
			</div>
			<div>
				<label for="last_name" class="block text-sm font-medium text-gray-700 mb-1">Last name</label>
				<input id="last_name" type="text" name="last_name" value={ u.LastName } maxlength="64" class={ idpInputClass }/>
				@FieldError(result.FieldErr("last_name"))
			</div>
		</div>
		<div>
			<label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email address</label>
			<input id="email" type="email" name="email" value={ u.Email } required maxlength="255" class={ idpInputClass }/>
			@FieldError(result.FieldErr("email"))
		</div>
		<p class="text-xs text-gray-500">Created { formatInstant(u.CreatedAt) }. Last changed { formatInstant(u.UpdatedAt) }.</p>
	}
}

// UserStatusCard controls whether and how the user can sign in.
templ UserStatusCard(props UserPageProps, result SectionResult) {
	@SectionCard(SectionCardProps{
		ID:          "section-status",
		Title:       "Status",
		Description: "Whether the user may sign in.",
		Action:      userSectionAction(props.Detail.User.PartitionID, props.Detail.User.ID.String(), "status"),
		Saved:       result.Saved,
		Error:       result.Error,
	}) {
		<div>
			<label for="lifecycle" class="block text-sm font-medium text-gray-700 mb-1">Account state</label>
			<select id="lifecycle" name="lifecycle" class={ idpInputClass + " bg-white" }>
				for _, state := range lifecycleStates() {
					<option value={ string(state) } selected?={ props.Detail.User.LifecycleState == state }>{ lifecycleLabel(state) }</option>
				}
			</select>
			@FieldError(result.FieldErr("lifecycle"))
		</div>
		@ToggleRow("blocked", "true", "Blocked", "A blocked user cannot sign in, whatever the account state.", props.Detail.User.Blocked, false)
		@ToggleRow("email_verified", "true", "Email address verified", "", props.Detail.User.EmailVerified, false)
		if props.IsSelf() {
			<p class="text-xs text-gray-500">This is your own account. You cannot block or deactivate it.</p>
		}
	}
}

func lifecycleStates() []model.ProfileLifecycleState {
	return []model.ProfileLifecycleState{
		model.LifecycleActivated, model.LifecycleRequested, model.LifecycleInvited, model.LifecycleCreated, model.LifecycleDeactivated,
	}
}

// UserPasswordCard sets a new local password. The field is never filled in and the stored hash is never shown.
templ UserPasswordCard(props UserPageProps, result SectionResult) {
	@SectionCard(SectionCardProps{
		ID:          "section-password",
		Title:       "Password",
		Description: "Set a new password for the local account. The user's current password is never shown.",
		Action:      userSectionAction(props.Detail.User.PartitionID, props.Detail.User.ID.String(), "password"),
		Saved:       result.Saved,
		Error:       result.Error,
	}) {
		<dl class="text-sm grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div>
				<dt class="text-gray-500">Local password</dt>
				<dd class="text-gray-900">
					if props.Detail.HasPassword {
						Set
					} else {
						Not set
					}
				</dd>
			</div>
			<div>
				<dt class="text-gray-500">Lockout</dt>
				<dd class="text-gray-900">
					if props.Detail.Locked {
						Locked until { formatInstantPtr(props.Detail.BlockedUntil) }
					} else {
						None
					}
				</dd>
			</div>
		</dl>
		<div>
			<label for="new_password" class="block text-sm font-medium text-gray-700 mb-1">New password</label>
			<input id="new_password" type="password" name="new_password" value="" autocomplete="new-password" minlength="8" maxlength="64" class={ idpInputClass + " font-mono" }/>
			@FieldError(result.FieldErr("new_password"))
			<p class="mt-1 text-xs text-gray-500">8 to 64 characters. Setting a password also ends a lockout.</p>
		</div>
	}
}
