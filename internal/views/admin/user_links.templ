package admin

import "sprezz-identity/internal/domain/port"

// linkSummary describes when a sign-in method was linked and last used.
func linkSummary(link port.UserLink) string {
	return idpTypeLabel(link.ProviderType) + ". Linked " + formatInstant(link.Identity.CoupledAt) + ". Last sign-in " + formatInstantPtr(link.Identity.LastLoginAt) + "."
}

// UserLinksCard lists the sign-in methods a user has and lets an administrator remove one. The last method can
// never be removed, which the service enforces; the button is only hidden as a convenience.
templ UserLinksCard(props UserPageProps, errMsg string) {
	<section id="section-links" class="bg-white border border-gray-200 rounded-xl shadow-xs scroll-mt-24">
		<div class="px-6 pt-5 pb-4 border-b border-gray-100">
			<h2 class="text-base font-bold text-gray-900">Sign-in methods</h2>
			<p class="mt-1 text-sm text-gray-500">The providers this user can sign in with.</p>
		</div>
		<div class="px-6 py-5 space-y-3">
			if errMsg != "" {
				<div class="p-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm" role="alert">{ errMsg }</div>
			}
			if len(props.Detail.Links) == 0 {
				<p class="text-sm text-gray-500">No sign-in methods. The user cannot sign in.</p>
			}
			<ul class="divide-y divide-gray-100">
				for _, link := range props.Detail.Links {
					@userLinkRow(props, link)
				}
			</ul>
		</div>
	</section>
}

templ userLinkRow(props UserPageProps, link port.UserLink) {
	<li class="py-3 flex items-center justify-between gap-4 text-sm">
		<div class="min-w-0">
			<p class="font-medium text-gray-900">{ link.ProviderName }</p>
			<p class="text-xs text-gray-500">
				{ linkSummary(link) }
			</p>
		</div>
		if len(props.Detail.Links) > 1 {
			<button
				type="button"
				hx-delete={ userURL(props.Detail.User.PartitionID, props.Detail.User.ID.String()) + "/identities/" + link.Identity.IdentityProviderID.String() }
				hx-target="#section-links"
				hx-swap="outerHTML"
				hx-confirm="Remove this sign-in method? The user can no longer sign in with it."
				class="shrink-0 text-red-600 hover:text-red-800 font-medium"
			>Remove</button>
		}
	</li>
}

// UserUnlockCard offers to clear a lockout; it only appears while the local account is locked.
templ UserUnlockNotice(props UserPageProps) {
	if props.Detail.Locked {
		<div class="p-4 bg-amber-50 border border-amber-200 rounded-xl flex items-center justify-between gap-4 text-sm">
			<span class="text-amber-900">This account is locked after repeated failed sign-ins until { formatInstantPtr(props.Detail.BlockedUntil) }.</span>
			<button
				type="button"
				hx-post={ userURL(props.Detail.User.PartitionID, props.Detail.User.ID.String()) + "/unlock" }
				hx-target="main"
				hx-swap="innerHTML"
				class="shrink-0 px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white rounded-lg font-semibold"
			>Unlock now</button>
		</div>
	}
}
