package admin

import "sprezz-identity/internal/domain/model"

// ApplicationPolicyCard picks the group and the profile the application follows.
templ ApplicationPolicyCard(props ApplicationPageProps, result SectionResult) {
	@SectionCard(SectionCardProps{
		ID:          "section-policy",
		Title:       "Group and profile",
		Description: "The group decides where and how users sign in, the profile decides how tokens are issued.",
		Action:      applicationSectionAction(props.Application.ClientID, "policy"),
		ReadOnly:    props.Application.IsSystem,
		Saved:       result.Saved,
		Error:       result.Error,
	}) {
		<div>
			<label for="group_id" class="block text-sm font-medium text-gray-700 mb-1">Group</label>
			<select id="group_id" name="group_id" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500">
				for _, g := range props.Groups {
					<option value={ g.ID.String() } selected?={ props.Application.GroupID == g.ID }>{ g.GroupName }</option>
				}
			</select>
			@FieldError(result.FieldErr("group_id"))
			<p class="mt-1 text-xs"><a href={ templ.SafeURL(groupURL(props.Application.GroupID.String())) } class="text-blue-700 hover:text-blue-900 font-medium">Open this group</a></p>
		</div>
		<div>
			<label for="profile_id" class="block text-sm font-medium text-gray-700 mb-1">Profile</label>
			<select id="profile_id" name="profile_id" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500">
				for _, p := range props.Profiles {
					<option value={ p.ID.String() } selected?={ props.Application.ProfileID == p.ID }>{ p.ProfileName } ({ string(p.TokenEndpointAuthMethod) })</option>
				}
			</select>
			@FieldError(result.FieldErr("profile_id"))
			<p class="mt-1 text-xs"><a href={ templ.SafeURL(profileURL(props.Application.ProfileID.String())) } class="text-blue-700 hover:text-blue-900 font-medium">Open this profile</a></p>
		</div>
	}
}

// ApplicationCredentialsCard resets the client secret. The new secret is shown once, inside the transaction.
templ ApplicationCredentialsCard(props ApplicationPageProps) {
	<section id="section-credentials" class="bg-white border border-gray-200 rounded-xl shadow-xs">
		<div class="px-6 pt-5 pb-4 border-b border-gray-100">
			<h2 class="text-base font-bold text-gray-900">Credentials</h2>
			<p class="mt-1 text-sm text-gray-500">The client secret is stored as a hash and cannot be shown again.</p>
		</div>
		<div class="px-6 py-5">
			if props.Profile != nil && props.Profile.TokenEndpointAuthMethod == model.AuthMethodNone {
				<p class="text-sm text-gray-600">This is a public client. It has no secret.</p>
			} else {
				<div id="client-secret-container" class="flex items-center gap-3">
					<div class="font-mono text-gray-400 bg-gray-50 px-3 py-2 border border-gray-200 rounded-lg flex-1">••••••••••••••••</div>
					<button
						type="button"
						hx-post={ applicationSectionAction(props.Application.ClientID, "reset-secret") }
						hx-target="#client-secret-container"
						hx-confirm="Reset the client secret? The current secret stops working immediately."
						class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg text-sm font-semibold transition-colors"
					>Reset secret</button>
				</div>
			}
		</div>
	</section>
}
