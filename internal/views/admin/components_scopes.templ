package admin

// ScopePickerProps configures the allowed-scope editor.
type ScopePickerProps struct {
	Allowed     []string
	Defaults    []string
	Suggestions []string
	Error       string
	DefaultsErr string
}

// ScopePicker edits the scopes a group allows. Every allowed scope has a checkbox that marks it as a default, so
// the default list can never contain a scope that is not allowed.
templ ScopePicker(props ScopePickerProps) {
	<div x-data="scopePicker" data-allowed={ marshalStringSlice(props.Allowed) } data-defaults={ marshalStringSlice(props.Defaults) } data-suggestions={ marshalStringSlice(props.Suggestions) } class="space-y-3">
		<template x-for="scope in allowed" :key="scope">
			<input type="hidden" name="allowed_scopes" :value="scope"/>
		</template>
		<template x-for="scope in defaults" :key="scope">
			<input type="hidden" name="default_scopes" :value="scope"/>
		</template>
		<div x-show="allowed.length === 0" x-cloak class="p-4 text-center text-sm text-gray-500 border border-dashed border-gray-300 rounded-lg">No scopes allowed yet.</div>
		<ul x-show="allowed.length > 0" x-cloak class="divide-y divide-gray-100 border border-gray-200 rounded-lg">
			<template x-for="scope in allowed" :key="scope">
				<li class="flex items-center gap-3 px-3 py-2">
					<span x-text="scope" class="flex-1 font-mono text-xs text-gray-800"></span>
					<label class="flex items-center gap-1.5 text-xs text-gray-600 select-none cursor-pointer">
						<input type="checkbox" :checked="isDefault(scope)" @change="toggleDefault(scope)" class="h-3.5 w-3.5 text-blue-600 border-gray-300 rounded-sm"/>
						Default
					</label>
					<button type="button" @click="removeScope(scope)" class="text-gray-400 hover:text-red-600 text-sm px-1" aria-label="Remove scope">&times;</button>
				</li>
			</template>
		</ul>
		<div x-show="unusedSuggestions.length > 0" x-cloak class="flex flex-wrap gap-1.5">
			<template x-for="scope in unusedSuggestions" :key="scope">
				<button type="button" @click="addSuggestion(scope)" class="px-2 py-1 text-xs font-mono border border-gray-200 rounded-md text-gray-600 hover:bg-gray-50">
					+ <span x-text="scope"></span>
				</button>
			</template>
		</div>
		<div class="flex gap-2">
			<input
				type="text"
				x-model="newScope"
				@keydown.enter.prevent="addScope()"
				placeholder="Custom scope, e.g. read:orders"
				aria-label="Custom scope"
				class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500"
			/>
			<button type="button" @click="addScope()" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-sm font-semibold shrink-0">Add</button>
		</div>
		<p x-show="error" x-cloak x-text="error" class="text-xs text-red-600"></p>
		@FieldError(props.Error)
		@FieldError(props.DefaultsErr)
		<p class="text-xs text-gray-500">Default scopes are granted when a client does not request specific scopes.</p>
	</div>
}
