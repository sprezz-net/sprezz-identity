package admin

import "sprezz-identity/internal/domain/model"

func hasGrant(profile *model.ApplicationProfile, grant model.GrantType) bool {
	for _, g := range profile.GrantTypes {
		if g == grant {
			return true
		}
	}
	return false
}

func boolString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

// ProfileAuthCard edits how clients authenticate and how tokens are signed.
templ ProfileAuthCard(profile *model.ApplicationProfile, result SectionResult, readOnly bool) {
	@SectionCard(SectionCardProps{
		ID:          "section-authentication",
		Title:       "Authentication",
		Description: "How applications prove who they are, and how their tokens are signed.",
		Action:      profileSectionAction(profile.ID.String(), "authentication"),
		ReadOnly:    readOnly,
		Saved:       result.Saved,
		Error:       result.Error,
	}) {
		@ProfileAuthFields(profile, result)
	}
}

// ProfileAuthFields is the field block shared by the authentication card and the new-profile form.
templ ProfileAuthFields(profile *model.ApplicationProfile, result SectionResult) {
	<div x-data="applicationFormManager" data-initial-auth-method={ string(profile.TokenEndpointAuthMethod) } data-enforce-rtr={ boolString(profile.EnforceRTR) } class="space-y-5">
		<div>
			<label for="token_endpoint_auth_method" class="block text-sm font-medium text-gray-700 mb-1">Token endpoint authentication</label>
			<select id="token_endpoint_auth_method" name="token_endpoint_auth_method" x-model="authMethod" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500">
				<option value="client_secret_post" selected?={ profile.TokenEndpointAuthMethod == model.AuthMethodClientSecretPost }>Client secret in the request body</option>
				<option value="client_secret_basic" selected?={ profile.TokenEndpointAuthMethod == model.AuthMethodClientSecretBasic }>Client secret in the HTTP Basic header</option>
				<option value="none" selected?={ profile.TokenEndpointAuthMethod == model.AuthMethodNone }>None (public client)</option>
			</select>
			@FieldError(result.FieldErr("token_endpoint_auth_method"))
			<p x-show="authMethod === 'none'" x-cloak class="mt-1 text-xs text-gray-500">Public clients have no secret, so refresh tokens always rotate and client credentials are unavailable.</p>
		</div>
		<div>
			<label for="signing_algorithm" class="block text-sm font-medium text-gray-700 mb-1">Token signing algorithm</label>
			<select id="signing_algorithm" name="signing_algorithm" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500">
				<option value="RS256" selected?={ profile.SigningAlgorithm == model.AlgRS256 }>RS256 (RSA with SHA-256)</option>
				<option value="ES256" selected?={ profile.SigningAlgorithm == model.AlgES256 }>ES256 (ECDSA with SHA-256)</option>
				<option value="EdDSA" selected?={ profile.SigningAlgorithm == model.AlgEdDSA }>EdDSA (Ed25519)</option>
			</select>
			@FieldError(result.FieldErr("signing_algorithm"))
		</div>
		<fieldset class="space-y-1">
			<legend class="block text-sm font-medium text-gray-700 mb-1">Grant types</legend>
			@ToggleRow("grant_types", string(model.GrantTypeAuthorizationCode), "Authorization code", "Interactive sign-in with PKCE", hasGrant(profile, model.GrantTypeAuthorizationCode), false)
			@ToggleRow("grant_types", string(model.GrantTypeRefreshToken), "Refresh token", "Lets the application renew sessions without asking the user again", hasGrant(profile, model.GrantTypeRefreshToken), false)
			@ToggleRow("grant_types", string(model.GrantTypeClientCredentials), "Client credentials", "Machine to machine access, confidential clients only", hasGrant(profile, model.GrantTypeClientCredentials), false)
			@ToggleRow("grant_types", string(model.GrantTypeTokenExchange), "Token exchange", "Trade an external token for a Sprezz token", hasGrant(profile, model.GrantTypeTokenExchange), false)
			@FieldError(result.FieldErr("grant_types"))
		</fieldset>
		<div class="flex items-start gap-3">
			<input type="checkbox" id="enforce_rtr" name="enforce_rtr" value="true" x-model="enforceRtr" :disabled="authMethod === 'none'" class="mt-0.5 h-4 w-4 text-blue-600 border-gray-300 rounded-sm"/>
			<label for="enforce_rtr" class="text-sm font-medium text-gray-800 select-none">
				Rotate refresh tokens
				<span class="block text-xs font-normal text-gray-500">A reused refresh token revokes the whole token family.</span>
			</label>
		</div>
	</div>
}
