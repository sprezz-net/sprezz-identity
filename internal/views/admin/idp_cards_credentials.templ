package admin

import "sprezz-identity/internal/domain/model"

// IDPDiscoverySummary shows what the provider advertised the last time it was contacted.
templ IDPDiscoverySummary(p *model.IdentityProvider) {
	if meta := discoveryMeta(p); meta != nil {
		<dl class="p-4 bg-gray-50 border border-gray-200 rounded-lg text-sm space-y-2">
			<div>
				<dt class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Issuer</dt>
				<dd class="font-mono text-gray-900 break-all">{ meta.Issuer }</dd>
			</div>
			<div>
				<dt class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Authorization endpoint</dt>
				<dd class="font-mono text-gray-700 break-all">{ meta.AuthorizationEndpoint }</dd>
			</div>
			<div>
				<dt class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Token endpoint</dt>
				<dd class="font-mono text-gray-700 break-all">{ meta.TokenEndpoint }</dd>
			</div>
			if len(meta.ScopesSupported) > 0 {
				<div>
					<dt class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Scopes offered</dt>
					<dd class="text-gray-700">{ joinList(meta.ScopesSupported) }</dd>
				</div>
			}
			<div>
				<dt class="text-xs font-semibold text-gray-500 uppercase tracking-wide">PKCE</dt>
				<dd class="text-gray-700">
					if containsString(meta.CodeChallengeMethodsSupported, "S256") {
						Supported (S256)
					} else {
						Not advertised
					}
				</dd>
			</div>
		</dl>
	} else {
		<p class="text-sm text-gray-500">No metadata stored yet. Save this card to fetch it.</p>
	}
}

// IDPCredentialsCard edits the client credentials. The stored secret is never sent to the browser: the field
// starts empty, and leaving it empty keeps the current secret.
templ IDPCredentialsCard(p *model.IdentityProvider, result SectionResult) {
	@SectionCard(SectionCardProps{
		ID:          "section-credentials",
		Title:       "Credentials",
		Description: "The client this console is registered as at the provider.",
		Action:      idpSectionAction(p.ID.String(), "credentials"),
		ReadOnly:    p.IsSystem,
		Saved:       result.Saved,
		Error:       result.Error,
	}) {
		<div>
			<label for="client_id" class="block text-sm font-medium text-gray-700 mb-1">Client ID</label>
			<input id="client_id" type="text" name="client_id" value={ p.Config.ClientID } autocomplete="off" class={ idpInputClass + " font-mono" }/>
			@FieldError(result.FieldErr("client_id"))
		</div>
		<div>
			<label for="client_secret" class="block text-sm font-medium text-gray-700 mb-1">Client secret</label>
			<input id="client_secret" type="password" name="client_secret" value="" autocomplete="new-password" placeholder={ secretPlaceholder(p) } class={ idpInputClass + " font-mono" }/>
			@FieldError(result.FieldErr("client_secret"))
			<p class="mt-1 text-xs text-gray-500">The secret is write-only. Leave the field empty to keep the current one.</p>
		</div>
	}
}

func secretPlaceholder(p *model.IdentityProvider) string {
	if p.Config.ClientSecret != "" {
		return "A secret is stored. Type to replace it."
	}
	return "No secret stored"
}
