package admin

import (
	"sprezz-identity/internal/domain/model"
	"sprezz-identity/internal/domain/port"
)

func signInAction(groupID string) string {
	return groupURL(groupID) + "/signin"
}

// SignInCard edits which identity providers may be used to sign in to applications of a group. Local accounts
// are an ordinary row in each partition: the real local identity provider, so the submitted value is its UUID.
templ SignInCard(props SignInCardProps) {
	@SectionCard(SectionCardProps{
		ID:          "section-signin",
		Title:       "Sign-in methods",
		Description: signInDescription(props),
		Action:      signInAction(props.Group.ID.String()),
		Saved:       props.Result.Saved,
		Error:       props.Result.Error,
	}) {
		@SignInFields(props)
	}
}

// SignInFields is the field block shared by the sign-in card and the new-group form.
templ SignInFields(props SignInCardProps) {
	<div class="space-y-4">
		for _, partition := range props.Partitions {
			@partitionBlock(props, partition)
		}
		if len(props.Partitions) == 0 {
			<p class="text-sm text-gray-500">No partitions are configured for this tenant.</p>
		}
	</div>
	<div>
		<label for="default_idp_id" class="block text-sm font-medium text-gray-700 mb-1">Default sign-in method</label>
		<select id="default_idp_id" name="default_idp_id" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500">
			<option value="" selected?={ props.Group.DefaultIDPID == nil }>Let users choose</option>
			for _, partition := range props.Partitions {
				for _, idp := range partition.Providers {
					if !(props.FederatedOnly && idp.IDPType == model.UsernamePasswordIDPType) {
						<option value={ idp.ID.String() } selected?={ isDefaultIDP(props.Group, idp.ID) }>{ providerLabel(idp) } ({ string(partition.PartitionName) })</option>
					}
				}
			}
		</select>
		@FieldError(props.Result.FieldErr("default_idp_id"))
		<p class="mt-1 text-xs text-gray-500">A default that is not local sends users straight to that provider and skips the local form, unless the client asks for the local provider with idp_hint.</p>
	</div>
	@FieldError(props.Result.FieldErr("allowed_idps"))
}

func signInDescription(props SignInCardProps) string {
	return "Users can sign in with " + itoa(totalAllowed(props.Group, props.Partitions)) + " of " + itoa(totalProviders(props.Partitions)) + " available providers."
}

func providerLabel(idp model.IdentityProvider) string {
	if idp.IDPType == model.UsernamePasswordIDPType {
		return "Local accounts"
	}
	return idp.Alias
}

templ partitionBlock(props SignInCardProps, partition model.PartitionWithProviders) {
	<div class="border border-gray-200 rounded-lg">
		<div class="flex items-center justify-between px-4 py-2 bg-gray-50 rounded-t-lg border-b border-gray-200">
			<h3 class="text-xs font-bold uppercase tracking-wider text-gray-500">Partition: { string(partition.PartitionName) }</h3>
			<span class="text-xs text-gray-500">{ itoa(allowedCount(props.Group, partition)) } of { itoa(len(partition.Providers)) } allowed</span>
		</div>
		<div class="px-4 py-2 space-y-1">
			for _, idp := range partition.Providers {
				if !(props.FederatedOnly && idp.IDPType == model.UsernamePasswordIDPType) {
					@ToggleRow("allowed_idps", idp.ID.String(), providerLabel(idp), providerHint(idp), idpAllowed(props.Group, idp.ID), false)
				}
			}
			if !props.FederatedOnly && !hasLocalProvider(partition) {
				<p class="text-xs text-gray-500 py-1">
					This partition has no local accounts provider.
					<a href={ templ.SafeURL(port.RouteAdmin + port.RouteAdminIdentityProviders) } class="text-blue-700 hover:text-blue-900 font-medium">Create one</a>
				</p>
			}
			if props.FederatedOnly && len(partition.Providers) == 0 {
				<p class="text-xs text-gray-500 py-1">No providers in this partition.</p>
			}
		</div>
	</div>
}

func providerHint(idp model.IdentityProvider) string {
	if idp.IDPType == model.UsernamePasswordIDPType {
		return "Username and password stored in this partition"
	}
	return "Federated provider (" + idp.IDPType + ")"
}
