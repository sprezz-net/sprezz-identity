package admin

import "sprezz-identity/internal/domain/model"

// CreateFormProps is shared by the three create pages.
type CreateFormProps struct {
	ActiveTenant model.Tenant
	Errors       map[string]string
	Error        string
	Values       map[string]string
}

// V returns the value the admin typed before a validation error, or an empty string.
func (p CreateFormProps) V(name string) string {
	return p.Values[name]
}

// E returns the error for a field.
func (p CreateFormProps) E(name string) string {
	return p.Errors[name]
}

// createShell is the frame of a create page: back link, title, form and actions.
templ createShell(title, backLabel, backURL, action, submitLabel string, props CreateFormProps) {
	@PageHeader(title, backLabel, backURL)
	<form hx-post={ action } hx-target="main" hx-swap="innerHTML" hx-indicator="#global-spinner" class="max-w-3xl space-y-6">
		if props.Error != "" {
			<div class="p-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm" role="alert">{ props.Error }</div>
		}
		<section class="bg-white border border-gray-200 rounded-xl shadow-xs">
			<div class="px-6 py-5 space-y-5">
				{ children... }
			</div>
			<div class="px-6 py-3 bg-gray-50 rounded-b-xl border-t border-gray-100 flex justify-end gap-3">
				<a href={ templ.SafeURL(backURL) } hx-get={ backURL } hx-target="main" hx-swap="innerHTML" hx-push-url="true" class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-semibold text-gray-700 bg-white hover:bg-gray-50">Cancel</a>
				<button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold shadow-xs">{ submitLabel }</button>
			</div>
		</section>
	</form>
}

// NewGroupContent creates a group with a name and sign-in methods. Everything else is edited on the group page.
templ NewGroupContent(props CreateFormProps, partitions []model.PartitionWithProviders) {
	@createShell("New group", "Groups", groupsBase(), groupsBase(), "Create group", props) {
		<div>
			<label for="group_name" class="block text-sm font-medium text-gray-700 mb-1">Group name</label>
			<input id="group_name" type="text" name="group_name" value={ props.V("group_name") } required maxlength="100" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500"/>
			@FieldError(props.E("group_name"))
		</div>
		@SignInFields(SignInCardProps{
			Group:      &model.ApplicationGroup{},
			Partitions: partitions,
			Result:     SectionResult{Errors: props.Errors},
		})
		<p class="text-xs text-gray-500">Redirect URIs, scopes and sign-out settings are added on the next page.</p>
	}
}

templ NewGroupPage(props CreateFormProps, partitions []model.PartitionWithProviders) {
	@AdminLayout(AdminLayoutProps{Title: "New group", CurrentTab: "clients", TenantName: props.ActiveTenant.Name}) {
		@NewGroupContent(props, partitions)
	}
}

// NewProfileContent creates a profile with secure defaults. Lifetimes are edited on the profile page.
templ NewProfileContent(props CreateFormProps, profile *model.ApplicationProfile) {
	@createShell("New profile", "Profiles", profilesBase(), profilesBase(), "Create profile", props) {
		<div>
			<label for="profile_name" class="block text-sm font-medium text-gray-700 mb-1">Profile name</label>
			<input id="profile_name" type="text" name="profile_name" value={ props.V("profile_name") } required maxlength="100" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500"/>
			@FieldError(props.E("profile_name"))
		</div>
		@ProfileAuthFields(profile, SectionResult{Errors: props.Errors})
		<p class="text-xs text-gray-500">Token lifetimes start at 15 minutes for access and ID tokens and 14 days for refresh tokens. Change them on the next page.</p>
	}
}

templ NewProfilePage(props CreateFormProps, profile *model.ApplicationProfile) {
	@AdminLayout(AdminLayoutProps{Title: "New profile", CurrentTab: "clients", TenantName: props.ActiveTenant.Name}) {
		@NewProfileContent(props, profile)
	}
}
