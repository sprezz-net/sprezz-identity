package admin

import "sprezz-identity/internal/domain/model"

// ProfileLifetimesCard edits the three token lifetimes.
templ ProfileLifetimesCard(profile *model.ApplicationProfile, result SectionResult, readOnly bool) {
	@SectionCard(SectionCardProps{
		ID:          "section-lifetimes",
		Title:       "Token lifetimes",
		Description: "How long each kind of token stays valid.",
		Action:      profileSectionAction(profile.ID.String(), "lifetimes"),
		ReadOnly:    readOnly,
		Saved:       result.Saved,
		Error:       result.Error,
	}) {
		@lifetimeField("Access token", "access_token_lifetime", lifetimeSeconds(profile.AccessTokenLifetime), result.FieldErr("access_token_lifetime"), "Between 1 minute and 24 hours.")
		@lifetimeField("ID token", "id_token_lifetime", lifetimeSeconds(profile.IDTokenLifetime), result.FieldErr("id_token_lifetime"), "Between 1 minute and 24 hours.")
		@lifetimeField("Refresh token", "refresh_token_lifetime", lifetimeSeconds(profile.RefreshTokenLifetime), result.FieldErr("refresh_token_lifetime"), "Between 1 minute and 90 days.")
	}
}

templ lifetimeField(label, name, seconds, errorStr, hint string) {
	<div x-data="lifetimeCalculator" data-initial-seconds={ seconds }>
		<input type="hidden" name={ name } :value="seconds"/>
		<label class="block text-sm font-medium text-gray-700 mb-1">{ label }</label>
		<div class="flex gap-2">
			<input type="number" min="1" x-model="value" @input="updateSeconds()" aria-label={ label + " lifetime" } class="w-28 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500"/>
			<select x-model="unit" @change="updateSeconds()" aria-label={ label + " unit" } class="px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white">
				<option value="seconds">Seconds</option>
				<option value="minutes">Minutes</option>
				<option value="hours">Hours</option>
				<option value="days">Days</option>
			</select>
		</div>
		@FieldError(errorStr)
		<p class="mt-1 text-xs text-gray-500">{ hint }</p>
	</div>
}
