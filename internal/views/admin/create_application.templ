package admin

import "sprezz-identity/internal/domain/model"

// NewApplicationContent registers an application. A confidential client's secret is shown once after creation.
templ NewApplicationContent(props CreateFormProps, groups []model.ApplicationGroup, profiles []model.ApplicationProfile) {
	@createShell("New application", "Applications", applicationsBase(), applicationsBase(), "Create application", props) {
		<div>
			<label for="application_name" class="block text-sm font-medium text-gray-700 mb-1">Application name</label>
			<input id="application_name" type="text" name="application_name" value={ props.V("application_name") } required maxlength="255" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-hidden focus:ring-2 focus:ring-blue-500"/>
			@FieldError(props.E("application_name"))
		</div>
		<div x-data="idSecretGenerator" data-initial-value={ props.V("client_id") }>
			<label for="client_id" class="block text-sm font-medium text-gray-700 mb-1">Client ID</label>
			<div class="flex gap-2">
				<input
					id="client_id"
					type="text"
					name="client_id"
					x-model="value"
					required
					pattern="^[a-zA-Z0-9\-_\.~]+$"
					title="Letters, digits and - _ . ~ only"
					class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono focus:outline-hidden focus:ring-2 focus:ring-blue-500"
				/>
				<button type="button" @click="generate()" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-sm font-semibold shrink-0">Generate</button>
			</div>
			@FieldError(props.E("client_id"))
			<p class="mt-1 text-xs text-gray-500">Cannot be changed later. Letters, digits and - _ . ~ only.</p>
		</div>
		<div>
			<label for="group_id" class="block text-sm font-medium text-gray-700 mb-1">Group</label>
			<select id="group_id" name="group_id" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500">
				<option value="">Choose a group</option>
				for _, g := range groups {
					<option value={ g.ID.String() } selected?={ props.V("group_id") == g.ID.String() }>{ g.GroupName }</option>
				}
			</select>
			@FieldError(props.E("group_id"))
			<p class="mt-1 text-xs">
				<a href={ templ.SafeURL(groupsBase() + "/new") } hx-get={ groupsBase() + "/new" } hx-target="main" hx-swap="innerHTML" hx-push-url="true" class="text-blue-700 hover:text-blue-900 font-medium">Need a new group?</a>
			</p>
		</div>
		<div>
			<label for="profile_id" class="block text-sm font-medium text-gray-700 mb-1">Profile</label>
			<select id="profile_id" name="profile_id" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:outline-hidden focus:ring-2 focus:ring-blue-500">
				<option value="">Choose a profile</option>
				for _, p := range profiles {
					<option value={ p.ID.String() } selected?={ props.V("profile_id") == p.ID.String() }>{ p.ProfileName } ({ string(p.TokenEndpointAuthMethod) })</option>
				}
			</select>
			@FieldError(props.E("profile_id"))
			<p class="mt-1 text-xs">
				<a href={ templ.SafeURL(profilesBase() + "/new") } hx-get={ profilesBase() + "/new" } hx-target="main" hx-swap="innerHTML" hx-push-url="true" class="text-blue-700 hover:text-blue-900 font-medium">Need a new profile?</a>
			</p>
		</div>
	}
}

templ NewApplicationPage(props CreateFormProps, groups []model.ApplicationGroup, profiles []model.ApplicationProfile) {
	@AdminLayout(AdminLayoutProps{Title: "New application", CurrentTab: "clients", TenantName: props.ActiveTenant.Name}) {
		@NewApplicationContent(props, groups, profiles)
	}
}
