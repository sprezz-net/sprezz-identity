package admin

import "strconv"

// NewIDPContent is the add flow. Without a type it offers the choices; with one it shows a short form. Everything
// else, such as scopes and assurance, is set on the provider's own page afterwards.
templ NewIDPContent(props IDPNewProps) {
	@PageHeader("Add identity provider", "Identity providers", idpsBase())
	if props.Type == "" {
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl">
			@idpTypeChoice("oidc", "OpenID Connect", "Let users sign in with an existing account at another provider, such as a company directory.")
			@idpTypeChoice("username-password", "Local accounts", "Users sign in with a username or email address and a password stored here. A partition can have one.")
		</div>
	} else {
		@newIDPForm(props)
	}
}

templ NewIDPPage(props IDPNewProps) {
	@AdminLayout(AdminLayoutProps{Title: "Add identity provider", CurrentTab: "idps", TenantName: props.ActiveTenant.Name}) {
		@NewIDPContent(props)
	}
}

templ idpTypeChoice(idpType, title, description string) {
	<a
		href={ templ.SafeURL(idpsBase() + "/new?type=" + idpType) }
		hx-get={ idpsBase() + "/new?type=" + idpType }
		hx-target="main"
		hx-swap="innerHTML"
		hx-push-url="true"
		class="block p-5 bg-white border border-gray-200 rounded-xl shadow-xs hover:border-blue-400 transition-colors"
	>
		<span class="block text-base font-bold text-gray-900">{ title }</span>
		<span class="block mt-1 text-sm text-gray-500">{ description }</span>
	</a>
}

templ newIDPForm(props IDPNewProps) {
	<form hx-post={ idpsBase() } hx-target="main" hx-swap="innerHTML" hx-indicator="#global-spinner" class="max-w-3xl space-y-6">
		<input type="hidden" name="idp_type" value={ props.Type }/>
		if props.Error != "" {
			<div class="p-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm" role="alert">{ props.Error }</div>
		}
		<section class="bg-white border border-gray-200 rounded-xl shadow-xs">
			<div class="px-6 pt-5 pb-4 border-b border-gray-100">
				<h2 class="text-base font-bold text-gray-900">{ idpTypeLabel(props.Type) }</h2>
			</div>
			<div class="px-6 py-5 space-y-5">
				<div>
					<label for="name" class="block text-sm font-medium text-gray-700 mb-1">Display name</label>
					<input id="name" type="text" name="name" value={ props.V("name") } required maxlength="100" class={ idpInputClass }/>
					@FieldError(props.Errors["name"])
				</div>
				<div>
					<label for="alias" class="block text-sm font-medium text-gray-700 mb-1">Alias</label>
					<input id="alias" type="text" name="alias" value={ props.V("alias") } required maxlength="63" placeholder="corp-sso" class={ idpInputClass + " font-mono" }/>
					@FieldError(props.Errors["alias"])
					<p class="mt-1 text-xs text-gray-500">Lowercase letters, digits, - and _. It identifies the provider and cannot be changed later.</p>
				</div>
				<div>
					<label for="partition_id" class="block text-sm font-medium text-gray-700 mb-1">Partition</label>
					<select id="partition_id" name="partition_id" class={ idpInputClass + " bg-white" }>
						for _, part := range props.Partitions {
							<option value={ strconv.FormatInt(part.ID, 10) } selected?={ props.V("partition_id") == strconv.FormatInt(part.ID, 10) }>{ partitionLabel(part) }</option>
						}
					</select>
					@FieldError(props.Errors["partition_id"])
					@FieldError(props.Errors["idp_type"])
				</div>
				if props.Type == "oidc" {
					@newOIDCFields(props)
				}
			</div>
		</section>
		<div class="flex items-center gap-3">
			<button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-semibold transition-colors shadow-xs">Add provider</button>
			<a href={ templ.SafeURL(idpsBase() + "/new") } hx-get={ idpsBase() + "/new" } hx-target="main" hx-swap="innerHTML" hx-push-url="true" class="text-sm font-medium text-gray-600 hover:text-gray-800">Choose another type</a>
		</div>
	</form>
}

templ newOIDCFields(props IDPNewProps) {
	<div>
		<label for="discovery_endpoint" class="block text-sm font-medium text-gray-700 mb-1">Discovery endpoint</label>
		<input id="discovery_endpoint" type="url" name="discovery_endpoint" value={ props.V("discovery_endpoint") } required placeholder="https://idp.example.com/.well-known/openid-configuration" class={ idpInputClass + " font-mono" }/>
		@FieldError(props.Errors["discovery_endpoint"])
		@FieldError(props.Errors["issuer"])
		<p class="mt-1 text-xs text-gray-500">The provider is contacted when you add it, and its issuer is taken from its answer.</p>
	</div>
	<div>
		<label for="client_id" class="block text-sm font-medium text-gray-700 mb-1">Client ID</label>
		<input id="client_id" type="text" name="client_id" value={ props.V("client_id") } autocomplete="off" class={ idpInputClass + " font-mono" }/>
		@FieldError(props.Errors["client_id"])
	</div>
	<div>
		<label for="client_secret" class="block text-sm font-medium text-gray-700 mb-1">Client secret</label>
		<input id="client_secret" type="password" name="client_secret" value="" autocomplete="new-password" class={ idpInputClass + " font-mono" }/>
		@FieldError(props.Errors["client_secret"])
	</div>
}
