package admin

import "sprezz-identity/internal/domain/model"

// IDPLocalPolicyCard edits how local accounts sign in and how repeated failures are handled.
templ IDPLocalPolicyCard(p *model.IdentityProvider, result SectionResult) {
	@SectionCard(SectionCardProps{
		ID:          "section-local-policy",
		Title:       "Sign-in policy",
		Description: "How people sign in with a local account and what happens after repeated failures.",
		Action:      idpSectionAction(p.ID.String(), "local-policy"),
		ReadOnly:    p.IsSystem,
		Saved:       result.Saved,
		Error:       result.Error,
	}) {
		<div>
			<label for="username_field" class="block text-sm font-medium text-gray-700 mb-1">Users sign in with</label>
			<select id="username_field" name="username_field" class={ idpInputClass + " bg-white" }>
				<option value="preferredUsername" selected?={ p.Config.UsernameField == "preferredUsername" }>Username</option>
				<option value="email" selected?={ p.Config.UsernameField == "email" }>Email address</option>
			</select>
			@FieldError(result.FieldErr("username_field"))
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			<div>
				<label for="max_failed_verification_count" class="block text-sm font-medium text-gray-700 mb-1">Failed attempts before lockout</label>
				<input id="max_failed_verification_count" type="number" name="max_failed_verification_count" value={ levelText(p.Config.MaxFailedVerificationCount) } min="3" max="20" class={ idpInputClass }/>
				@FieldError(result.FieldErr("max_failed_verification_count"))
			</div>
			<div>
				<label for="password_blocked_time" class="block text-sm font-medium text-gray-700 mb-1">Lockout duration (seconds)</label>
				<input id="password_blocked_time" type="number" name="password_blocked_time" value={ levelText(p.Config.PasswordBlockedTime) } min="60" max="86400" class={ idpInputClass }/>
				@FieldError(result.FieldErr("password_blocked_time"))
			</div>
		</div>
		@ToggleRow("allow_decoupling", "true", "Users may unlink this sign-in method", "Lets a user remove the local password from their account.", p.Config.AllowDecoupling, false)
	}
}

// IDPUsageCard shows who relies on a provider.
templ IDPUsageCard(props IDPPageProps) {
	<section id="section-usage" class="bg-white border border-gray-200 rounded-xl shadow-xs scroll-mt-24">
		<div class="px-6 pt-5 pb-4 border-b border-gray-100">
			<h2 class="text-base font-bold text-gray-900">Usage</h2>
			<p class="mt-1 text-sm text-gray-500">Who relies on this provider.</p>
		</div>
		<dl class="px-6 py-5 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
			<div>
				<dt class="text-gray-500">Linked users</dt>
				<dd class="text-gray-900 font-semibold">{ itoa(props.Usage.LinkedUsers) }</dd>
			</div>
			<div>
				<dt class="text-gray-500">Last sign-in</dt>
				<dd class="text-gray-900">{ formatTime(props.Usage.LastLoginAt) }</dd>
			</div>
			<div>
				<dt class="text-gray-500">Allowed by groups</dt>
				<dd class="text-gray-900">
					if len(props.Usage.GroupNames) == 0 {
						None
					} else {
						{ joinList(props.Usage.GroupNames) }
					}
				</dd>
			</div>
		</dl>
	</section>
}
