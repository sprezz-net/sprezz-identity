package admin

const systemLockPath = "M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z"

// SystemBadge marks objects that are provisioned and protected by the platform.
templ SystemBadge() {
	<span
		class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-800 text-white"
		title="Managed by Sprezz. Changes are restricted to protect administrative access."
	>
		<svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={ systemLockPath } clip-rule="evenodd"></path></svg>
		System
	</span>
}

// SystemBanner explains why a system-managed page is read-only.
templ SystemBanner(message string) {
	<div class="mb-6 p-4 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-700 flex gap-3" role="note">
		<svg class="h-5 w-5 text-slate-500 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={ systemLockPath } clip-rule="evenodd"></path></svg>
		<p>{ message }</p>
	</div>
}

// FlashMessage shows the success message carried by a redirect.
templ FlashMessage(msg string) {
	if msg != "" {
		<div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm font-medium" role="status">{ msg }</div>
	}
}

// EmptyState fills a list that has no rows yet.
templ EmptyState(title, hint string) {
	<div class="px-6 py-12 text-center">
		<p class="text-sm font-semibold text-gray-700">{ title }</p>
		if hint != "" {
			<p class="mt-1 text-sm text-gray-500">{ hint }</p>
		}
	</div>
}

// ConfirmDeleteProps configures a danger zone with a typed confirmation.
type ConfirmDeleteProps struct {
	Action   string
	Expected string
	Noun     string
	Warning  string
	Blocked  string // when set, deletion is refused and this explains why
	Error    string
}

// ConfirmDelete is a danger zone whose delete button stays disabled until the typed text matches. The server
// re-checks the confirmation, so the disabled state is only a convenience.
templ ConfirmDelete(props ConfirmDeleteProps) {
	<section class="border border-red-200 rounded-xl bg-white">
		<div class="px-6 pt-5 pb-3 border-b border-red-100">
			<h2 class="text-base font-bold text-red-700">Danger zone</h2>
		</div>
		<div class="px-6 py-5 space-y-4">
			<p class="text-sm text-gray-600">{ props.Warning }</p>
			if props.Error != "" {
				<div class="p-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm" role="alert">{ props.Error }</div>
			}
			if props.Blocked != "" {
				<p class="text-sm font-medium text-gray-800 p-3 bg-gray-50 border border-gray-200 rounded-lg">{ props.Blocked }</p>
			} else {
				<form hx-delete={ props.Action } hx-target="closest section" hx-swap="outerHTML" x-data="typedConfirm" data-expected={ props.Expected } class="space-y-3">
					<label class="block text-sm font-medium text-gray-700">
						Type <span class="font-mono font-semibold">{ props.Expected }</span> to delete this { props.Noun }
						<input
							type="text"
							name="confirmation"
							x-model="typed"
							autocomplete="off"
							class="mt-1 w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono focus:outline-hidden focus:ring-2 focus:ring-red-500"
						/>
					</label>
					<button
						type="submit"
						:disabled="!matches"
						class="px-4 py-2 bg-red-600 hover:bg-red-700 disabled:opacity-40 disabled:cursor-not-allowed text-white rounded-lg text-sm font-semibold transition-colors"
					>Delete { props.Noun }</button>
				</form>
			}
		</div>
	</section>
}
