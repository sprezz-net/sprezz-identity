package admin

import "github.com/google/uuid"

func containsUUID(list []uuid.UUID, target uuid.UUID) bool {
	for _, id := range list {
		if id == target {
			return true
		}
	}
	return false
}

templ StatusBadge(isEnabled bool) {
	if isEnabled {
		<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-100">Active</span>
	} else {
		<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-100">Disabled</span>
	}
}

// ApplicationSecretPanel shows a newly generated client secret exactly once. The continue link leads to the
// application page; it is empty after a reset, where the admin is already on that page.
templ ApplicationSecretPanel(clientID string, plainSecret string, continueURL string) {
	<div class="bg-white p-6 rounded-xl shadow-xs max-w-xl border border-amber-200" role="alert">
		<h2 class="text-lg font-bold text-gray-900">Copy the client secret now</h2>
		<p class="mt-2 text-sm text-gray-600">
			This is the secret of <strong class="font-mono">{ clientID }</strong>. <strong class="text-red-600">It is shown only once</strong> and cannot be recovered later.
		</p>
		<div class="mt-4 p-3 bg-amber-50 border border-amber-200 rounded-lg text-sm font-mono text-gray-900 break-all select-all">{ plainSecret }</div>
		if continueURL != "" {
			<div class="mt-5 flex justify-end">
				<a href={ templ.SafeURL(continueURL) } class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-sm font-semibold">I have saved it</a>
			</div>
		}
	</div>
}
